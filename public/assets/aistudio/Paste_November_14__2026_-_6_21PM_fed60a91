  <!-- Inline Script: Frontend Architecture & Promisified Backend Adapter -->
  <script>
    // =========================================================================
    // SYSTEM INITIALIZATION & CLIENT-SIDE SIMULATOR / BRIDGE
    // =========================================================================
    var CURRENT_USER = {
      email: 'dipen.khadka@birathealthcare.com',
      role: 'Super Admin'
    };

    var APP_STATE = {
      bootstrap: null,
      dashboard: null,
      lookups: null,
      currentModule: 'dashboard',
      exchangeRates: { USD: 135.50, INR: 1.6015, EUR: 146.20, NPR: 1.00, GBP: 172.80 }
    };

    // Live Clock in Top Right
    function startClock() {
      function update() {
        var now = new Date();
        var options = { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false };
        var clockEl = document.getElementById('liveClockDisplay');
        if (clockEl) {
          clockEl.innerText = now.toLocaleDateString('en-US', options) + ' NPT';
        }
      }
      update();
      setInterval(update, 1000);
    }

    // Promisified Server Caller with Fallback for Local/Preview
    function callServer(functionName) {
      var args = Array.prototype.slice.call(arguments, 1);
      return new Promise(function(resolve, reject) {
        if (window.google && google.script && google.script.run) {
          google.script.run
            .withSuccessHandler(resolve)
            .withFailureHandler(reject)[functionName].apply(null, args);
        } else {
          // Robust client-side simulator when running outside Apps Script container
          simulateAppsScriptCall(functionName, args).then(resolve).catch(reject);
        }
      });
    }

    // Toast Notification Utility
    function showToast(message, type) {
      type = type || 'success';
      var container = document.getElementById('toast-container');
      var toast = document.createElement('div');
      toast.className = 'toast toast-' + (type === 'error' ? 'error' : (type === 'info' ? 'info' : 'success'));
      var icon = type === 'error' ? 'circle-exclamation' : (type === 'info' ? 'circle-info' : 'circle-check');
      toast.innerHTML = '<i class="fa-solid fa-' + icon + '"></i><span>' + message + '</span>';
      container.appendChild(toast);
      setTimeout(function() {
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(-10px)';
        toast.style.transition = 'all 0.3s ease';
        setTimeout(function() { toast.remove(); }, 300);
      }, 4000);
    }

    // Navigation Switcher
    function switchModule(modName, opts) {
      opts = opts || {};
      APP_STATE.currentModule = modName;
      document.querySelectorAll('.module-view').forEach(function(el) { el.classList.remove('active'); });
      document.querySelectorAll('#sidebar .nav-item').forEach(function(el) { el.classList.remove('active'); });

      var targetMod = document.getElementById('mod-' + modName);
      if (targetMod) targetMod.classList.add('active');

      // Update sidebar active indicator
      var navItems = document.querySelectorAll('#sidebar .nav-item');
      for (var i = 0; i < navItems.length; i++) {
        if (navItems[i].getAttribute('onclick') && navItems[i].getAttribute('onclick').indexOf(modName) !== -1) {
          navItems[i].classList.add('active');
          break;
        }
      }

      var titles = {
        dashboard: 'Executive Dashboard',
        indents: 'Purchase Indents',
        suppliers: 'Supplier Master Database',
        forwarders: 'Freight Forwarders',
        quotations: 'Quotations & Proforma Invoices',
        purchase_orders: 'Purchase Orders (PO)',
        lctt: 'Import LC / TT Payment Management',
        shipments: 'Import Shipment Tracking',
        tenders: 'Tender Management',
        tender_tracking: 'Tender Execution Tracking',
        items: 'Item Master & Material Codes',
        bom: 'Bill of Materials (BOM)',
        production: 'Production Process & Material Issue',
        inventory: 'Inventory Ledger & Warehouse Balances',
        grn: 'Goods Receipt Note (GRN)',
        dispatch: 'Dispatch Management',
        reports: 'Reports & Analytics',
        settings: 'Settings & Database Setup'
      };

      document.getElementById('pageTitleText').innerText = titles[modName] || 'Dipen System';

      // Load specific module data
      loadModuleData(modName, opts);
    }

    function toggleSidebar() {
      document.getElementById('sidebar').classList.toggle('open');
    }

    // Modal Control
    function openModal(id) {
      var modal = document.getElementById(id);
      if (modal) modal.classList.add('active');
    }

    function closeModal(id) {
      var modal = document.getElementById(id);
      if (modal) modal.classList.remove('active');
    }

    // Universal Table Filter
    function filterTable(tableId, query) {
      query = (query || '').toLowerCase();
      var table = document.getElementById(tableId);
      if (!table) return;
      var trs = table.querySelectorAll('tbody tr');
      trs.forEach(function(tr) {
        tr.style.display = tr.innerText.toLowerCase().indexOf(query) !== -1 ? '' : 'none';
      });
    }

    function filterTableByCol(tableId, colIndex, val) {
      val = (val || '').toLowerCase();
      var table = document.getElementById(tableId);
      if (!table) return;
      var trs = table.querySelectorAll('tbody tr');
      trs.forEach(function(tr) {
        var td = tr.querySelectorAll('td')[colIndex];
        if (!td || !val) {
          tr.style.display = '';
        } else {
          tr.style.display = td.innerText.toLowerCase().indexOf(val) !== -1 ? '' : 'none';
        }
      });
    }

    // Data Loaders
    function loadModuleData(modName, opts) {
      switch(modName) {
        case 'dashboard':
          reloadDashboard();
          break;
        case 'indents':
          loadIndents();
          break;
        case 'suppliers':
          loadSuppliers();
          break;
        case 'forwarders':
          loadForwarders();
          break;
        case 'quotations':
          loadQuotations();
          break;
        case 'purchase_orders':
          loadPurchaseOrders();
          break;
        case 'lctt':
          loadLCTT();
          break;
        case 'shipments':
          loadShipments();
          break;
        case 'tenders':
          loadTenders();
          break;
        case 'tender_tracking':
          loadTenderTracking();
          break;
        case 'items':
          loadItems();
          break;
        case 'bom':
          loadRoutines();
          break;
        case 'production':
          loadProductionRuns();
          break;
        case 'inventory':
          loadInventory(opts);
          break;
        case 'grn':
          loadGRN();
          break;
        case 'dispatch':
          loadDispatch();
          break;
        case 'reports':
          runSelectedReport();
          break;
      }
    }

    // =========================================================================
    // DASHBOARD & CHARTS
    // =========================================================================
    var charts = {};

    function reloadDashboard() {
      var period = document.getElementById('kpiPaymentFilter').value;
      var dateFrom = document.getElementById('chartDateFrom').value;
      var dateTo = document.getElementById('chartDateTo').value;

      callServer('getDashboard', { period: period, dateFrom: dateFrom, dateTo: dateTo })
        .then(function(res) {
          if (!res || !res.kpis) return;
          var kpis = res.kpis;

          document.getElementById('kpiTotalPOValue').innerText = 'NPR ' + Math.round(kpis.totalPOValueNPR).toLocaleString();
          document.getElementById('kpiPendingPOCount').innerText = kpis.pendingPOCount;
          document.getElementById('kpiPendingPOVal').innerText = 'NPR ' + Math.round(kpis.pendingPOValueNPR).toLocaleString() + ' pending fulfillment';

          document.getElementById('kpiSupplierOutstanding').innerText = 'NPR ' + Math.round(kpis.outstandingPayments.supplierOutstandingNPR).toLocaleString();
          document.getElementById('kpiSupplierPaid').innerText = 'Paid: NPR ' + Math.round(kpis.outstandingPayments.supplierPaidNPR).toLocaleString();
          document.getElementById('kpiCustomerOutstanding').innerText = 'NPR ' + Math.round(kpis.outstandingPayments.customerOutstandingNPR).toLocaleString();

          document.getElementById('kpiShipmentTotalBadge').innerText = kpis.shipmentsInTransit.total + ' Active';
          document.getElementById('kpiShipmentsIndia').innerText = kpis.shipmentsInTransit.india;
          document.getElementById('kpiShipmentsThird').innerText = kpis.shipmentsInTransit.thirdCountry;

          document.getElementById('kpiInventoryVal').innerText = 'NPR ' + Math.round(kpis.totalInventoryValueNPR).toLocaleString();
          document.getElementById('kpiLowStockCount').innerText = kpis.lowStockCount;
          document.getElementById('kpiProdQty').innerText = kpis.totalProductionQty.toLocaleString() + ' pcs';
          document.getElementById('kpiDispatchQty').innerText = kpis.totalDispatchQty.toLocaleString() + ' pcs';

          // Render Low Stock list in dashboard
          var lowStockBody = document.getElementById('dashLowStockTableBody');
          if (res.lists.lowStockItems.length === 0) {
            lowStockBody.innerHTML = '<tr><td colspan="4" style="text-align:center; color:#10b981;">All stocks above reorder level</td></tr>';
          } else {
            lowStockBody.innerHTML = res.lists.lowStockItems.slice(0, 6).map(function(item) {
              return '<tr><td><strong>' + item.itemCode + '</strong></td><td>' + item.itemName + '</td><td style="color:#dc2626; font-weight:700;">' + item.currentStock + ' ' + item.unit + '</td><td>' + item.reorderLevel + '</td></tr>';
            }).join('');
          }

          // Render recent transactions
          var txBody = document.getElementById('recentTransactionsTableBody');
          if (res.lists.recentTransactions && res.lists.recentTransactions.length > 0) {
            txBody.innerHTML = res.lists.recentTransactions.map(function(tx) {
              return '<tr><td style="font-size:0.75rem; color:#64748b;">' + tx.Timestamp + '</td><td><span class="badge badge-navy">' + tx.UserEmail + '</span></td><td><strong>' + tx.Action + '</strong></td><td><span class="badge badge-info">' + tx.Module + '</span></td><td>' + (tx.RecordId || '-') + '</td><td style="font-size:0.75rem;">' + (typeof tx.Details === 'object' ? JSON.stringify(tx.Details) : tx.Details) + '</td></tr>';
            }).join('');
          }

          // Render Charts
          renderCharts(res.charts);
        })
        .catch(function(err) {
          showToast('Error loading dashboard: ' + err.message, 'error');
        });
    }

    function renderCharts(chartData) {
      if (!chartData) return;

      // Procurement Chart
      var ctxP = document.getElementById('procurementChart');
      if (ctxP) {
        if (charts.procurement) charts.procurement.destroy();
        charts.procurement = new Chart(ctxP, {
          type: 'line',
          data: {
            labels: chartData.procurementTrend.labels,
            datasets: [{
              label: 'Procurement (NPR)',
              data: chartData.procurementTrend.data,
              borderColor: '#0891b2',
              backgroundColor: 'rgba(6, 182, 212, 0.1)',
              fill: true,
              tension: 0.35,
              borderWidth: 2
            }]
          },
          options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
        });
      }

      // Dispatch Chart
      var ctxD = document.getElementById('dispatchChart');
      if (ctxD) {
        if (charts.dispatch) charts.dispatch.destroy();
        charts.dispatch = new Chart(ctxD, {
          type: 'bar',
          data: {
            labels: chartData.dispatchTrend.labels,
            datasets: [{
              label: 'Dispatched Units',
              data: chartData.dispatchTrend.data,
              backgroundColor: '#10b981',
              borderRadius: 4
            }]
          },
          options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
        });
      }

      // Category Pie Chart
      var ctxC = document.getElementById('categoryChart');
      if (ctxC) {
        if (charts.category) charts.category.destroy();
        var catLabels = Object.keys(chartData.productionByCategory || {});
        var catVals = catLabels.map(function(k) { return chartData.productionByCategory[k]; });
        charts.category = new Chart(ctxC, {
          type: 'doughnut',
          data: {
            labels: catLabels,
            datasets: [{
              data: catVals,
              backgroundColor: ['#06b6d4', '#3b82f6', '#10b981', '#f59e0b', '#8b5cf6', '#ef4444']
            }]
          },
          options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'right' } } }
        });
      }
    }

    function clearChartDates() {
      document.getElementById('chartDateFrom').value = '';
      document.getElementById('chartDateTo').value = '';
      reloadDashboard();
    }

    // =========================================================================
    // MODULE: INDENTS
    // =========================================================================
    function loadIndents() {
      callServer('getRecords', 'Indents')
        .then(function(rows) {
          var tbody = document.getElementById('indentTableBody');
          if (!rows || rows.length === 0) {
            tbody.innerHTML = '<tr><td colspan="10" style="text-align:center; color:#94a3b8;">No purchase indents found. Create one!</td></tr>';
            return;
          }
          tbody.innerHTML = rows.map(function(ind) {
            var pBadge = ind.Priority === 'Urgent' ? 'badge-danger' : (ind.Priority === 'High' ? 'badge-warning' : 'badge-navy');
            var sBadge = ind.Status === 'Approved' ? 'badge-success' : (ind.Status === 'Rejected' ? 'badge-danger' : 'badge-info');
            return '<tr>' +
              '<td><strong>' + ind.IndentNo + '</strong></td>' +
              '<td>' + (ind.Date || '') + '</td>' +
              '<td>' + (ind.Department || '') + '</td>' +
              '<td>' + (ind.Requester || '') + '</td>' +
              '<td><strong>' + ind.ItemCode + '</strong> - ' + (ind.ItemName || '') + '</td>' +
              '<td>' + ind.RequiredQty + ' ' + (ind.Unit || '') + '</td>' +
              '<td>' + (ind.RequiredDeliveryDate || '') + '</td>' +
              '<td><span class="badge ' + pBadge + '">' + ind.Priority + '</span></td>' +
              '<td><span class="badge ' + sBadge + '">' + (ind.Status || 'Pending') + '</span></td>' +
              '<td>' +
                (ind.Status !== 'Approved' ? '<button class="btn btn-secondary btn-sm" onclick="approveIndent(\'' + ind.IndentNo + '\')"><i class="fa-solid fa-check" style="color:#10b981;"></i> Approve</button>' : '<span style="color:#10b981; font-weight:700;"><i class="fa-solid fa-circle-check"></i> Approved</span>') +
              '</td>' +
            '</tr>';
          }).join('');
        });
    }

    function onIndentItemChange(itemCode) {
      callServer('getRecords', 'Items', { ItemCode: itemCode }).then(function(items) {
        if (items && items.length > 0) {
          document.getElementById('indentItemName').value = items[0].ItemName;
          document.getElementById('indentItemUnit').value = items[0].Unit;
        }
      });
    }

    function submitIndent() {
      var form = document.getElementById('formIndent');
      var data = {
        Department: form.Department.value,
        Requester: form.Requester.value,
        ItemCode: form.ItemCode.value,
        ItemName: document.getElementById('indentItemName').value,
        RequiredQty: form.RequiredQty.value,
        Unit: document.getElementById('indentItemUnit').value,
        RequiredDeliveryDate: form.RequiredDeliveryDate.value,
        Priority: form.Priority.value,
        Remarks: form.Remarks.value,
        Status: 'Pending',
        Date: new Date().toISOString().split('T')[0]
      };
      callServer('saveRecord', 'Indents', data, CURRENT_USER.email)
        .then(function(res) {
          showToast('Indent ' + res.id + ' submitted successfully!');
          closeModal('modalIndent');
          loadIndents();
        })
        .catch(function(err) { showToast(err.message, 'error'); });
    }

    function approveIndent(id) {
      callServer('setApproval', 'Indents', id, 'Approved', 'Approved by ' + CURRENT_USER.email, CURRENT_USER.email)
        .then(function() {
          showToast('Indent ' + id + ' approved!');
          loadIndents();
        });
    }

    // =========================================================================
    // MODULE: SUPPLIERS
    // =========================================================================
    function loadSuppliers() {
      callServer('getRecords', 'Suppliers').then(function(rows) {
        var tbody = document.getElementById('supplierTableBody');
        if (!rows || rows.length === 0) {
          tbody.innerHTML = '<tr><td colspan="10" style="text-align:center; color:#94a3b8;">No suppliers found.</td></tr>';
          return;
        }
        tbody.innerHTML = rows.map(function(s) {
          return '<tr>' +
            '<td><strong>' + s.SupplierId + '</strong></td>' +
            '<td><strong>' + s.Name + '</strong><br><span style="font-size:0.75rem; color:#64748b;">' + (s.Address || '') + '</span></td>' +
            '<td>PAN: ' + (s.PanNo || '-') + '<br>GST: ' + (s.GstNo || '-') + '</td>' +
            '<td>' + (s.ContactPerson || '') + '</td>' +
            '<td>' + s.Phone + '<br><a href="mailto:' + s.Email + '" style="color:var(--cyan-600);">' + s.Email + '</a></td>' +
            '<td><span class="badge badge-navy">' + (s.Country || 'Nepal') + '</span></td>' +
            '<td>' + (s.PaymentTerms || '') + '</td>' +
            '<td><span class="badge badge-info">' + (s.Currency || 'NPR') + '</span></td>' +
            '<td><span style="color:#f59e0b; font-weight:700;"><i class="fa-solid fa-star"></i> ' + (s.Rating || '5.0') + '</span></td>' +
            '<td><button class="btn btn-secondary btn-sm" onclick="deleteRecordPrompt(\'Suppliers\', \'' + s.SupplierId + '\')"><i class="fa-solid fa-trash" style="color:#ef4444;"></i></button></td>' +
          '</tr>';
        }).join('');
      });
    }

    function submitSupplier() {
      var form = document.getElementById('formSupplier');
      var data = {
        Name: form.Name.value,
        PanNo: form.PanNo.value,
        GstNo: form.GstNo.value,
        ContactPerson: form.ContactPerson.value,
        Phone: form.Phone.value,
        Email: form.Email.value,
        Country: form.Country.value,
        Address: form.Address.value,
        PaymentTerms: form.PaymentTerms.value,
        Currency: form.Currency.value,
        LeadTimeDays: form.LeadTimeDays.value,
        Rating: form.Rating.value
      };
      callServer('saveRecord', 'Suppliers', data, CURRENT_USER.email).then(function() {
        showToast('Supplier saved successfully!');
        closeModal('modalSupplier');
        loadSuppliers();
      });
    }

    // =========================================================================
    // MODULE: FREIGHT FORWARDERS
    // =========================================================================
    function loadForwarders() {
      callServer('getRecords', 'FreightForwarder').then(function(rows) {
        var tbody = document.getElementById('forwarderTableBody');
