          '<td><input type="number" class="form-control" value="' + itm.qty + '" onchange="quoteItems[' + idx + '].qty=this.value; calculateQuoteTotals()" style="padding:4px 8px; width:80px;"></td>' +
          '<td><input type="text" class="form-control" value="' + itm.unit + '" onchange="quoteItems[' + idx + '].unit=this.value" style="padding:4px 8px; width:60px;"></td>' +
          '<td><input type="number" step="0.01" class="form-control" value="' + itm.rate + '" onchange="quoteItems[' + idx + '].rate=this.value; calculateQuoteTotals()" style="padding:4px 8px; width:90px;"></td>' +
