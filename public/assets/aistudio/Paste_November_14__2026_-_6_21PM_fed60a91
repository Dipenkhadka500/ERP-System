    function calculateQuoteTotals() {
      var subtotal = 0;
      quoteItems.forEach(function(itm) {
        subtotal += (parseFloat(itm.qty) || 0) * (parseFloat(itm.rate) || 0);
      });
      var freight = parseFloat(document.getElementById('quoteFreight').value) || 0;
      var other = parseFloat(document.getElementById('quoteOther').value) || 0;
      var total = subtotal + freight + other;

      var curr = document.getElementById('quoteCurrency').value;
      document.getElementById('quoteCurrLabel').innerText = curr;
      document.getElementById('quoteTotalVal').value = curr + ' ' + total.toLocaleString(undefined, { minimumFractionDigits: 2 });
    }

