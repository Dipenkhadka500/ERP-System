              ${issueHtml || '<tr><td colspan="8" style="text-align:center; padding:12px;">No issue items recorded</td></tr>'}
            </tbody>
            <tfoot>
              <tr style="background: #f8fafc; font-weight: bold;">
                <td colspan="3" style="text-align: right; border: 1px solid #cbd5e1; padding: 6px 8px;">Total Material Consumption:</td>
                <td style="text-align: right; border: 1px solid #cbd5e1; padding: 6px 8px;">${totalBomIssue.toFixed(3)}</td>
                <td style="border: 1px solid #cbd5e1;"></td>
                <td style="text-align: right; border: 1px solid #cbd5e1; padding: 6px 8px; background: #eff6ff; color: #1e40af;">${totalActIssue.toFixed(3)}</td>
                <td style="text-align: right; border: 1px solid #cbd5e1; padding: 6px 8px; color: ${netIssueVar > 0 ? '#b91c1c' : '#15803d'};">
                  ${netIssueVar > 0 ? '+' : ''}${netIssueVar.toFixed(3)}
                </td>
                <td style="border: 1px solid #cbd5e1;"></td>
              </tr>
            </tfoot>
          </table>

          <!-- Section 2: Production Receipt -->
          <h3 style="font-size: 12px; font-weight: 800; color: #15803d; text-transform: uppercase; margin: 18px 0 6px 0; letter-spacing: 0.5px;">
            2. PRODUCTION RECEIPT (FINISHED / INTERMEDIATE OUTPUT RECEIVED)
          </h3>
          <table style="width: 100%; border-collapse: collapse; font-size: 11px; margin-bottom: 16px;">
            <thead>
              <tr style="background: #f1f5f9; text-transform: uppercase; font-size: 10px; color: #475569;">
                <th style="border: 1px solid #cbd5e1; padding: 6px 8px; text-align: left;">Item Code</th>
                <th style="border: 1px solid #cbd5e1; padding: 6px 8px; text-align: left;">Output Item Description</th>
                <th style="border: 1px solid #cbd5e1; padding: 6px 8px; text-align: center;">Unit</th>
                <th style="border: 1px solid #cbd5e1; padding: 6px 8px; text-align: right;">BOM Planned Qty</th>
                <th style="border: 1px solid #cbd5e1; padding: 6px 8px; text-align: right; background: #f0fdf4;">Actual Receipt Qty</th>
                <th style="border: 1px solid #cbd5e1; padding: 6px 8px; text-align: right;">Variance</th>
                <th style="border: 1px solid #cbd5e1; padding: 6px 8px; text-align: left;">Remarks</th>
              </tr>
            </thead>
            <tbody>
              ${recHtml || '<tr><td colspan="7" style="text-align:center; padding:12px;">No receipt items recorded</td></tr>'}
            </tbody>
            <tfoot>
              <tr style="background: #f8fafc; font-weight: bold;">
                <td colspan="3" style="text-align: right; border: 1px solid #cbd5e1; padding: 6px 8px;">Total Finished Output:</td>
                <td style="text-align: right; border: 1px solid #cbd5e1; padding: 6px 8px;">${totalBomRec.toLocaleString()}</td>
                <td style="text-align: right; border: 1px solid #cbd5e1; padding: 6px 8px; background: #f0fdf4; color: #166534;">${totalActRec.toLocaleString()}</td>
                <td style="text-align: right; border: 1px solid #cbd5e1; padding: 6px 8px; color: ${netRecVar >= 0 ? '#15803d' : '#b91c1c'};">
                  ${netRecVar > 0 ? '+' : ''}${netRecVar}
                </td>
                <td style="border: 1px solid #cbd5e1;"></td>
              </tr>
            </tfoot>
          </table>

          <!-- Variance Analysis & Summary Box -->
          <div style="background: #fdf6b2; border: 1px solid #fef08a; border-radius: 6px; padding: 10px 14px; margin-bottom: 24px; font-size: 11px; color: #723b10; display: flex; justify-content: space-between; align-items: center;">
            <div>
              <b>Material Efficiency Analysis:</b> Net Consumption Variance: <b>${netIssueVar.toFixed(3)} ${category === 'WIP' ? 'KG' : 'Units'}</b> | Output Yield Variance: <b>${netRecVar >= 0 ? '+' : ''}${netRecVar} ${unit}</b>
            </div>
            <div style="font-weight: 700; color: #0f291e;">
              Execution Status: <span style="color: #15803d;">COMPLIANT</span>
            </div>
          </div>

          <!-- Official Signatory Matrix -->
          <div style="margin-top: 28px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; text-align: center; font-size: 11px; color: #334155;">
            <div>
              <div style="height: 40px;"></div>
              <div style="border-top: 1px solid #94a3b8; width: 80%; margin: 0 auto 4px auto;"></div>
              <b>Prepared &amp; Issued By:</b><br>Production Supervisor
            </div>
            <div>
              <div style="height: 40px;"></div>
              <div style="border-top: 1px solid #94a3b8; width: 80%; margin: 0 auto 4px auto;"></div>
              <b>Checked &amp; Verified By:</b><br>QA &amp; Quality Control In-Charge
            </div>
            <div>
              <div style="height: 40px;"></div>
              <div style="border-top: 1px solid #94a3b8; width: 80%; margin: 0 auto 4px auto;"></div>
              <b>Approved By:</b><br>Factory Manager / Managing Director
            </div>
          </div>
        </div>
      `;
    }

    // Print Slip in PDF with Preview Modal & Popup Window Trigger
    function printProductionSlip(customRun) {
      const routineId = document.getElementById('prodRoutineSelector').value;
      if (!customRun && (!state.currentProdBOM && !routineId)) {
        showBOMToast('Please select a Routine Name and enter Quantity before printing slip.', 'error');
        document.getElementById('prodRoutineSelector').focus();
        return;
      }

      const slipHtml = buildProductionSlipHtml(customRun);
      
      // Update Preview Modal
      document.getElementById('prodSlipPrintArea').innerHTML = slipHtml;
      document.getElementById('prodSlipModal').classList.add('open');

      // Trigger pop-up print window
      try {
        const printWindow = window.open('', '_blank', 'width=950,height=800');
        if (printWindow) {
          printWindow.document.open();
          printWindow.document.write(`
            <!DOCTYPE html>
            <html>
            <head>
              <meta charset="utf-8">
              <title>Production Slip - Birat Healthcare</title>
              <style>
                @page { size: A4 portrait; margin: 12mm 15mm; }
                body { font-family: -apple-system, BlinkMacSystemFont, Arial, sans-serif; margin: 0; padding: 0; background: #ffffff; color: #1e293b; }
                @media print { body { -webkit-print-color-adjust: exact; print-color-adjust: exact; } }
              </style>
            </head>
            <body>
              ${slipHtml}
              <script>
                window.onload = function() {
                  window.focus();
                  window.print();
                };
              <\/script>
            </body>
            </html>
          `);
          printWindow.document.close();
        }
      } catch (e) {
        console.warn('Popup print blocked, opened modal preview instead', e);
      }
    }

    function closeProdSlipModal() {
      document.getElementById('prodSlipModal').classList.remove('open');
    }

    function triggerProductionSlipPrint() {
      const slipHtml = document.getElementById('prodSlipPrintArea').innerHTML;
      try {
        const printWindow = window.open('', '_blank', 'width=950,height=800');
        if (printWindow) {
          printWindow.document.open();
          printWindow.document.write(`
            <!DOCTYPE html>
            <html>
            <head>
              <meta charset="utf-8">
              <title>Production Slip - Birat Healthcare</title>
              <style>
                @page { size: A4 portrait; margin: 12mm 15mm; }
                body { font-family: -apple-system, BlinkMacSystemFont, Arial, sans-serif; margin: 0; padding: 0; background: #ffffff; }
                @media print { body { -webkit-print-color-adjust: exact; print-color-adjust: exact; } }
              </style>
            </head>
            <body>
              ${slipHtml}
              <script>
                window.onload = function() { window.focus(); window.print(); };
              <\/script>
            </body>
            </html>
          `);
          printWindow.document.close();
        } else {
          window.print();
        }
      } catch (e) {
        window.print();
      }
    }

    function downloadProductionSlipHtml() {
      const routineName = (state.currentProdBOM ? state.currentProdBOM.routine.routineName : 'Production_Run').replace(/\s+/g, '_');
      const prodDate = document.getElementById('prodDate').value || new Date().toISOString().substring(0, 10);
      const slipHtml = document.getElementById('prodSlipPrintArea').innerHTML || buildProductionSlipHtml();
      const fullHtml = `<!DOCTYPE html><html><head><meta charset="utf-8"><title>Production_Slip_${routineName}</title><style>@page{size:A4 portrait;margin:12mm;}body{font-family:Arial,sans-serif;margin:0;padding:20px;}</style></head><body>${slipHtml}</body></html>`;
      
      const blob = new Blob([fullHtml], { type: 'text/html;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = `Production_Slip_${routineName}_${prodDate}.html`;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      showBOMToast('Downloaded Production Slip HTML! Open in browser and print to save as PDF.', 'success');
    }

    function printHistoricalRun(runId) {
      const run = state.productionRuns.find(r => r.runId === runId);
      if (!run) {
        showBOMToast('Run record not found: ' + runId, 'error');
        return;
      }
      printProductionSlip(run);
    }

    // Export Production to Real Excel (.xls) and CSV
    function exportProductionToExcel() {
      const routineSelector = document.getElementById('prodRoutineSelector');
      const routineId = routineSelector.value;
      if (!state.currentProdBOM && !routineId) {
        showBOMToast('Please select a Routine Name before exporting sheet.', 'error');
        routineSelector.focus();
        return;
      }

      const routineName = state.currentProdBOM ? state.currentProdBOM.routine.routineName : (routineSelector.options[routineSelector.selectedIndex] ? routineSelector.options[routineSelector.selectedIndex].text : 'Production_Run');
      const prodDate = document.getElementById('prodDate').value || new Date().toISOString().substring(0, 10);
      const plannedQty = document.getElementById('prodQuantity').value || '1000';
      const supervisor = document.getElementById('prodSupervisor').value || 'Dipen Khadka';

      // Gather Issues
      const issueRows = [];
      const trsIssue = document.querySelectorAll('#tbodyProdIssue tr');
      trsIssue.forEach(r => {
        if (r.cells.length >= 7 && r.querySelector('.prod-bom-qty')) {
          issueRows.push({
            code: r.cells[0].innerText.trim(),
            name: r.cells[1].innerText.trim(),
            unit: r.cells[2].innerText.trim(),
            bomQty: r.querySelector('.prod-bom-qty').innerText.trim(),
            wt: r.querySelector('.prod-wt-input') ? r.querySelector('.prod-wt-input').value.trim() : '-',
            actualQty: r.querySelector('.prod-act-issue-input') ? r.querySelector('.prod-act-issue-input').value.trim() : '',
            variance: r.querySelector('.prod-issue-variance') ? r.querySelector('.prod-issue-variance').innerText.trim() : '0',
            remarks: r.querySelector('.prod-issue-remark') ? r.querySelector('.prod-issue-remark').value.trim() : ''
          });
        }
      });

      // Gather Receipts
      const recRows = [];
      const trsRec = document.querySelectorAll('#tbodyProdReceipt tr');
      trsRec.forEach(r => {
        if (r.cells.length >= 6 && r.querySelector('.prod-bom-rec-qty')) {
          recRows.push({
            code: r.cells[0].innerText.trim(),
            name: r.cells[1].innerText.trim(),
            unit: r.cells[2].innerText.trim(),
            bomQty: r.querySelector('.prod-bom-rec-qty').innerText.trim().replace(/,/g, ''),
            actualQty: r.querySelector('.prod-act-rec-input') ? r.querySelector('.prod-act-rec-input').value.trim() : '',
            variance: r.querySelector('.prod-rec-variance') ? r.querySelector('.prod-rec-variance').innerText.trim() : '0',
            remarks: r.querySelector('.prod-rec-remark') ? r.querySelector('.prod-rec-remark').value.trim() : ''
          });
        }
      });

      if (issueRows.length === 0 && recRows.length === 0) {
        showBOMToast('No production items to export. Please select a valid routine.', 'error');
        return;
      }

      // 1. Build Formatted HTML Excel Spreadsheet (.xls)
      let xlsHtml = `
        <html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40">
        <head>
          <meta charset="utf-8">
          <style>
            table { border-collapse: collapse; font-family: Arial, sans-serif; font-size: 11pt; }
            th { background-color: #0f291e; color: #ffffff; font-weight: bold; padding: 6px 10px; border: 1px solid #333333; }
            td { padding: 5px 8px; border: 1px solid #cccccc; }
            .section-header { background-color: #1b4332; color: #ffffff; font-weight: bold; font-size: 12pt; }
            .meta-header { background-color: #f1f5f9; font-weight: bold; }
            .total-row { background-color: #f8fafc; font-weight: bold; }
          </style>
        </head>
        <body>
          <table>
            <tr><td colspan="7" style="font-size: 16pt; font-weight: bold; color: #0f291e; text-align: center;">BIRAT HEALTHCARE INDUSTRIES PVT. LTD.</td></tr>
            <tr><td colspan="7" style="font-size: 11pt; color: #475569; text-align: center;">PRODUCTION ISSUE &amp; RECEIPT VOUCHER</td></tr>
            <tr><td colspan="7"></td></tr>
            <tr class="meta-header"><td colspan="2">Routine Name:</td><td colspan="5"><b>${routineName}</b></td></tr>
            <tr class="meta-header"><td colspan="2">Production Date:</td><td colspan="5">${prodDate}</td></tr>
            <tr class="meta-header"><td colspan="2">Planned Quantity:</td><td colspan="5">${plannedQty}</td></tr>
            <tr class="meta-header"><td colspan="2">Supervisor:</td><td colspan="5">${supervisor}</td></tr>
            <tr><td colspan="7"></td></tr>
            <tr><th colspan="7" class="section-header">1. PRODUCTION ISSUE (MATERIAL CONSUMPTION)</th></tr>
            <tr>
              <th>Item Code</th>
              <th>Item Name</th>
              <th>Unit</th>
              <th>BOM Standard Qty</th>
              <th>Actual Issue Qty</th>
              <th>Variance Qty</th>
              <th>Remarks</th>
            </tr>
      `;

      issueRows.forEach(item => {
        xlsHtml += `
          <tr>
            <td>${item.code}</td>
            <td>${item.name}</td>
            <td align="center">${item.unit}</td>
            <td align="right">${item.bomQty}</td>
            <td align="right" style="background-color: #eff6ff; font-weight: bold;">${item.actualQty}</td>
            <td align="right" style="font-weight: bold;">${item.variance}</td>
            <td>${item.remarks}</td>
          </tr>
        `;
      });

      xlsHtml += `
            <tr><td colspan="7"></td></tr>
            <tr><th colspan="7" class="section-header">2. PRODUCTION RECEIPT (FINISHED OUTPUT)</th></tr>
            <tr>
              <th>Item Code</th>
              <th>Item Name</th>
              <th>Unit</th>
              <th>BOM Planned Qty</th>
              <th>Actual Receipt Qty</th>
              <th>Variance Qty</th>
              <th>Remarks</th>
            </tr>
      `;

      recRows.forEach(item => {
        xlsHtml += `
          <tr>
            <td>${item.code}</td>
            <td>${item.name}</td>
            <td align="center">${item.unit}</td>
            <td align="right">${item.bomQty}</td>
            <td align="right" style="background-color: #f0fdf4; font-weight: bold; color: #166534;">${item.actualQty}</td>
            <td align="right" style="font-weight: bold;">${item.variance}</td>
            <td>${item.remarks}</td>
          </tr>
        `;
      });

      xlsHtml += `
          </table>
        </body>
        </html>
      `;

      // Download formatted Excel .xls
      const xlsBlob = new Blob([xlsHtml], { type: 'application/vnd.ms-excel;charset=utf-8' });
      const xlsUrl = URL.createObjectURL(xlsBlob);
      const xlsLink = document.createElement('a');
      xlsLink.href = xlsUrl;
      const cleanRoutine = routineName.replace(/[^a-zA-Z0-9_-]/g, '_');
      xlsLink.download = `Production_Run_${cleanRoutine}_${prodDate}.xls`;
      document.body.appendChild(xlsLink);
      xlsLink.click();
      document.body.removeChild(xlsLink);

      // 2. Also prepare and download CSV for portable tabular import
      let csv = `BIRAT HEALTHCARE INDUSTRIES PVT. LTD.\n`;
      csv += `Production Issue & Receipt Record\n`;
      csv += `Date: ${prodDate}\n`;
      csv += `Routine: ${routineName}\n`;
      csv += `Planned Production Qty: ${plannedQty}\n`;
      csv += `Supervisor: ${supervisor}\n\n`;

      csv += `--- PRODUCTION ISSUE (MATERIAL CONSUMPTION) ---\n`;
      csv += `Item Code,Item Name,Unit,BOM Quantity,Actual Issue Quantity,Variance Quantity,Remarks\n`;
      issueRows.forEach(r => {
        csv += `"${r.code}","${r.name}","${r.unit}",${r.bomQty},${r.actualQty},"${r.variance}","${r.remarks}"\n`;
      });

      csv += `\n--- PRODUCTION RECEIPT (FINISHED OUTPUT) ---\n`;
      csv += `Item Code,Item Name,Unit,BOM Quantity,Actual Receipt Quantity,Variance Quantity,Remarks\n`;
      recRows.forEach(r => {
        csv += `"${r.code}","${r.name}","${r.unit}",${r.bomQty},${r.actualQty},"${r.variance}","${r.remarks}"\n`;
      });

      downloadCSV(csv, `Production_Run_${cleanRoutine}_${prodDate}.csv`);

      // 3. Save to Google Sheets if running in Google Apps Script
      callBOMServer('exportProductionRunToSheet', {
        productionDate: prodDate,
        routineId: state.currentProdBOM ? state.currentProdBOM.routine.routineId : routineId,
        routineName: routineName,
        processCategory: state.currentProdBOM ? state.currentProdBOM.routine.processCategory : 'WIP',
        plannedQuantity: parseFloat(plannedQty) || 1000,
        unit: state.currentProdBOM ? state.currentProdBOM.routine.unit : 'PCS',
        recordedBy: supervisor,
        issues: issueRows.map(i => ({ itemCode: i.code, itemName: i.name, unit: i.unit, bomQuantity: parseFloat(i.bomQty)||0, actualQuantity: parseFloat(i.actualQty)||0, remarks: i.remarks })),
        receipts: recRows.map(r => ({ itemCode: r.code, itemName: r.name, unit: r.unit, bomQuantity: parseFloat(r.bomQty)||0, actualQuantity: parseFloat(r.actualQty)||0, remarks: r.remarks }))
      }).then(() => {
        showBOMToast('Exported Production Sheet (.xls & .csv) and logged to Google Sheets!', 'success');
      }).catch(() => {
        showBOMToast('Exported Production Sheet (.xls & .csv) successfully!', 'success');
      });
    }

    function downloadCSV(csvContent, fileName) {
      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.setAttribute('href', url);
      link.setAttribute('download', fileName);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }

    function showBOMToast(message, type = 'success') {
      const toast = document.getElementById('toastNotification');
      const msg = document.getElementById('toastMessage');
      const icon = document.getElementById('toastIcon');

      msg.innerText = message;
      toast.className = `toast show ${type}`;
      icon.className = (type === 'success') ? 'fa-solid fa-circle-check' : 'fa-solid fa-triangle-exclamation';

      setTimeout(() => {
        toast.className = 'toast';
      }, 4000);
    }
  
</script>
</body>
</html>
