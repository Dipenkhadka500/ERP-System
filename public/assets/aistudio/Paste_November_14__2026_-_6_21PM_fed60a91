    function buildBOMDocumentHtml() {
      const isWIP = (state.activeCategory === 'WIP');
      const bomName = document.getElementById('inputBomName').value.trim() || '240MM REGULAR';
      const autoRoutine = document.getElementById('inputRoutineName').value.trim() || ('RT-' + bomName);
