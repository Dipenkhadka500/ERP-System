    .chart-head h4 { font-size: 0.9rem; font-weight: 700; color: var(--navy-900); }

    /* Responsive */
    @media (max-width: 900px) {
      #sidebar { position: fixed; left: -260px; height: 100%; }
      #sidebar.open { left: 0; }
      .form-grid, .form-grid-3, .bom-split-grid, .charts-grid { grid-template-columns: 1fr; }
    }
  </style>
