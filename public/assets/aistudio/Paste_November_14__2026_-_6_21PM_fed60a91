      const effectiveDate = document.getElementById('inputEffectiveDate').value || new Date().toISOString().substring(0, 10);

      const issueData = getTableData(isWIP ? 'WIP_ISSUE' : 'FG_ISSUE');
      const receiptData = getTableData('RECEIPT');

      let issueRowsHtml = '';
      let totalIssueAmt = 0;
      let totalIssueWeight = 0;

      issueData.forEach(item => {
        if (isWIP) {
          totalIssueAmt += item.expectedAmount;
          totalIssueWeight += item.weightPerPiece;
          issueRowsHtml += `
            <tr>
              <td style="font-weight: bold; border: 1px solid #cbd5e1; padding: 6px 8px;">${item.itemCode}</td>
              <td style="border: 1px solid #cbd5e1; padding: 6px 8px;">${item.itemName}</td>
