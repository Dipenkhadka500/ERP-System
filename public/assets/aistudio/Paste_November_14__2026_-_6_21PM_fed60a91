    // Populate Routine Selector with search filter support for 100+ routines
    function populateRoutineSelector(targetRoutineIdToSelect) {
      const sel = document.getElementById('routineSelector');
      const searchVal = (document.getElementById('routineSearchInput').value || '').trim().toLowerCase();
      sel.innerHTML = '';

      const categoryRoutines = state.routines.filter(r => {
        if (state.activeCategory === 'WIP') {
          return r.processCategory.toLowerCase() === 'wip';
        } else {
          return r.processCategory.toLowerCase() === 'finished goods';
        }
      });

      // Filter by search query if user typed anything
      const filtered = categoryRoutines.filter(r => {
        if (!searchVal) return true;
        return (
          r.routineName.toLowerCase().includes(searchVal) ||
          r.bomName.toLowerCase().includes(searchVal) ||
          (r.parentItemCode && r.parentItemCode.toLowerCase().includes(searchVal)) ||
          (r.productName && r.productName.toLowerCase().includes(searchVal))
        );
      });

      // Update badge count
      const badge = document.getElementById('routineCountBadge');
      if (searchVal) {
        badge.innerText = `Showing ${filtered.length} of ${categoryRoutines.length} Routines`;
      } else {
        badge.innerText = `${categoryRoutines.length} Routines`;
      }

      if (filtered.length === 0) {
        sel.innerHTML = '<option value="">-- No Matching Routines --</option>';
        return;
      }

      filtered.forEach(r => {
        const opt = document.createElement('option');
        opt.value = r.routineId;
        opt.textContent = `${r.routineName} (${r.productName || r.parentItemCode})`;
        sel.appendChild(opt);
      });

      // Select target routine, or previous, or first
      if (targetRoutineIdToSelect && filtered.some(r => r.routineId === targetRoutineIdToSelect)) {
        sel.value = targetRoutineIdToSelect;
      } else if (state.currentRoutineId && filtered.some(r => r.routineId === state.currentRoutineId)) {
        sel.value = state.currentRoutineId;
      } else {
        sel.value = filtered[0].routineId;
      }

      onRoutineSelected();
    }

