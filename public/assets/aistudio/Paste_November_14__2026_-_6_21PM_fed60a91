    function calculateProdMaterials() {
      if (!activeBOMForProd) return;
      var plannedQty = parseFloat(document.getElementById('prodPlannedQty').value) || 0;
      var bomYield = parseFloat(activeBOMForProd.OutputQty) || 1;
      var ratio = plannedQty / bomYield;

      var inputs = [];
      try { inputs = JSON.parse(activeBOMForProd.InputItemsJSON); } catch(e) {}

      var preview = document.getElementById('prodMaterialsList');
      preview.innerHTML = inputs.map(function(inp) {
        var req = (parseFloat(inp.qty) || 0) * ratio;
        return '<div style="display:flex; justify-content:space-between; padding:4px 0; border-bottom:1px solid #e2e8f0;">' +
          '<span><strong>' + inp.itemCode + '</strong> (' + inp.itemName + ')</span>' +
          '<span style="font-weight:700; color:#b45309;">Required: ' + req.toFixed(2) + ' ' + inp.unit + '</span>' +
        '</div>';
      }).join('');
    }

