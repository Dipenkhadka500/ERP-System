      const search = (document.getElementById('itemMasterSearchInput').value || '').trim().toLowerCase();
      const cat = state.masterModalCategory;
      const items = (state.itemMaster && state.itemMaster.length) ? state.itemMaster : mockItemMaster;

      const filtered = items.filter(item => {
        const matchesCat = (cat === 'ALL' || item.category === cat);
        const matchesSearch = !search || (
          item.itemCode.toLowerCase().includes(search) ||
          item.itemName.toLowerCase().includes(search) ||
          (item.description && item.description.toLowerCase().includes(search))
        );
        return matchesCat && matchesSearch;
      });

      const badge = document.getElementById('itemMasterModalCountBadge');
      if (badge) {
        badge.innerText = `Showing ${filtered.length} of ${items.length} Items`;
      }

      const tbody = document.getElementById('tbodyItemMasterModal');
      tbody.innerHTML = '';

      if (filtered.length === 0) {
        tbody.innerHTML = `<tr><td colspan="8" style="text-align: center; padding: 24px; color: var(--text-muted);">No master items found matching "${search}".</td></tr>`;
        return;
      }

      filtered.forEach(item => {
        let catClass = 'cat-rm';
        if (item.category === 'Packaging Material') catClass = 'cat-pm';
        else if (item.category === 'WIP') catClass = 'cat-wip';
        else if (item.category === 'Finished Goods') catClass = 'cat-fg';

        const specs = (item.widthMM > 0 || item.gsm > 0 || item.lengthMM > 0)
          ? `${item.widthMM}mm × ${item.gsm}g × ${item.lengthMM}mm`
          : '-';

        const rateStr = item.ratePerKG > 0 ? `NPR ${item.ratePerKG.toFixed(2)} / KG` : (item.ratePerUnit > 0 ? `NPR ${item.ratePerUnit.toFixed(2)} / ${item.unit}` : '-');

        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td><span class="item-code-badge">${item.itemCode}</span></td>
          <td>
            <div style="font-weight: 600; color: #1e293b;">${item.itemName}</div>
            <div style="font-size: 11px; color: #64748b;">${item.description || ''}</div>
          </td>
          <td><span class="item-cat-badge ${catClass}">${item.category}</span></td>
          <td style="text-align: center;"><b>${item.unit || 'PCS'}</b></td>
          <td style="text-align: right; font-family: monospace; font-size: 11px;">${specs}</td>
          <td style="text-align: right; font-weight: 600; color: var(--primary);">${rateStr}</td>
          <td style="text-align: right; font-size: 11px;">${(item.currentStock || 0).toLocaleString()}</td>
          <td style="text-align: center;">
            <button class="btn btn-primary btn-xs" onclick="onModalSelectClicked('${item.itemCode}')">
              <i class="fa-solid fa-check"></i> Select
            </button>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    function onModalSelectClicked(itemCode) {
      const items = (state.itemMaster && state.itemMaster.length) ? state.itemMaster : mockItemMaster;
      const item = items.find(i => i.itemCode === itemCode);
      if (!item) return;

      if (!state.activeItemPickerTarget) {
        if (state.activeCategory === 'WIP') {
          addProductionIssueRow();
          const tbody = document.getElementById('tbodyProductionIssue');
          const newIdx = tbody.children.length - 1;
          selectMasterItemForRow(newIdx, 'wip_issue', item);
        } else {
          addProductionIssueRow();
          const tbody = document.getElementById('tbodyProductionIssue');
          const newIdx = tbody.children.length - 1;
          selectMasterItemForRow(newIdx, 'fg_issue', item);
        }
      } else {
        const { rowIndex, tableType } = state.activeItemPickerTarget;
        if (rowIndex === null || rowIndex === undefined) {
          if (tableType === 'issue' || tableType === 'wip_issue' || tableType === 'fg_issue') {
            addProductionIssueRow();
            const tbody = document.getElementById('tbodyProductionIssue');
            const newIdx = tbody.children.length - 1;
            selectMasterItemForRow(newIdx, state.activeCategory === 'WIP' ? 'wip_issue' : 'fg_issue', item);
          } else if (tableType === 'receipt') {
            addProductionReceiptRow();
            const tbody = document.getElementById('tbodyProductionReceipt');
            const newIdx = tbody.children.length - 1;
            selectMasterItemForRow(newIdx, 'receipt', item);
          } else if (tableType === 'new_routine_parent') {
            selectMasterItemForRow(null, 'new_routine_parent', item);
          }
        } else {
          selectMasterItemForRow(rowIndex, tableType, item);
        }
      }

      closeItemMasterPickerModal();
    }

    function selectMasterItemForRow(rowIndex, tableType, item) {
      if (!item) return;

      if (tableType === 'wip_issue' || (tableType === 'issue' && state.activeCategory === 'WIP')) {
        const rows = document.querySelectorAll('#tbodyProductionIssue tr');
        const r = rows[rowIndex];
        if (r) {
          r.querySelector('.input-itemcode').value = item.itemCode;
          r.querySelector('.input-itemname').value = item.itemName;
          r.querySelector('.input-width').value = item.widthMM || 0;
          r.querySelector('.input-gsm').value = item.gsm || 0;
          r.querySelector('.input-length').value = item.lengthMM || 0;
          r.querySelector('.input-rate').value = item.ratePerKG || 0;
          recalcWIPRow(rowIndex);
        }
      } else if (tableType === 'fg_issue' || (tableType === 'issue' && state.activeCategory === 'FG')) {
        const rows = document.querySelectorAll('#tbodyProductionIssue tr');
        const r = rows[rowIndex];
        if (r) {
          r.querySelector('.input-fg-code').value = item.itemCode;
          r.querySelector('.input-fg-name').value = item.itemName;
          r.querySelector('.input-fg-unit').value = item.unit || 'PCS';
          const qty = parseFloat(r.querySelector('.input-fg-qty').value) || 1;
          const rate = item.ratePerUnit > 0 ? item.ratePerUnit : item.ratePerKG;
          r.querySelector('.input-fg-amount').value = (qty * rate).toFixed(2);
          updateTotalsAndReceiptSync();
        }
      } else if (tableType === 'receipt' || tableType === 'wip_receipt' || tableType === 'fg_receipt') {
        const rows = document.querySelectorAll('#tbodyProductionReceipt tr');
        const r = rows[rowIndex];
        if (r) {
          r.querySelector('.input-rec-code').value = item.itemCode;
          r.querySelector('.input-rec-name').value = item.itemName;
          r.querySelector('.input-rec-unit').value = item.unit || 'PCS';
          updateTotalsAndReceiptSync();
        }
      } else if (tableType === 'new_routine_parent') {
        document.getElementById('modalNewItemCode').value = item.itemCode;
        document.getElementById('modalNewProductName').value = item.itemName;
        if (item.unit) {
          document.getElementById('modalNewUnit').value = item.unit;
        }
      }

      closeAllItemDropdowns();
      showBOMToast(`Selected: ${item.itemCode} - ${item.itemName}`, 'success');
    }

    // Inline Searchable Dropdown for Table Cells
    function showItemDropdown(inputEl, rowIndex, tableType, fieldType) {
      closeAllItemDropdowns();
      const wrapper = inputEl.closest('.item-picker-cell');
      if (!wrapper) return;
      const menu = wrapper.querySelector('.item-dropdown-menu');
      if (!menu) return;

      renderItemDropdownOptions(menu, inputEl.value, rowIndex, tableType, fieldType);
      menu.style.display = 'block';
    }

    function filterItemDropdown(inputEl, rowIndex, tableType, fieldType) {
      const wrapper = inputEl.closest('.item-picker-cell');
      if (!wrapper) return;
      const menu = wrapper.querySelector('.item-dropdown-menu');
      if (!menu) return;

      renderItemDropdownOptions(menu, inputEl.value, rowIndex, tableType, fieldType);
      menu.style.display = 'block';
    }

    function renderItemDropdownOptions(menuEl, query, rowIndex, tableType, fieldType) {
      const q = (query || '').trim().toLowerCase();
      const items = (state.itemMaster && state.itemMaster.length) ? state.itemMaster : mockItemMaster;

      let filtered = items.filter(item => {
        return (
          item.itemCode.toLowerCase().includes(q) ||
          item.itemName.toLowerCase().includes(q) ||
          (item.category && item.category.toLowerCase().includes(q))
        );
      });

      if (!q) {
        if (tableType === 'wip_issue') {
          filtered = filtered.filter(i => i.category === 'Raw Material' || i.itemCode.startsWith('RM-'));
        } else if (tableType === 'fg_issue') {
          filtered = filtered.filter(i => i.category === 'Packaging Material' || i.category === 'WIP' || i.itemCode.startsWith('PM-') || i.itemCode.startsWith('WIP-'));
        } else if (tableType === 'receipt') {
          filtered = filtered.filter(i => i.category === 'WIP' || i.category === 'Finished Goods' || i.itemCode.startsWith('WIP-') || i.itemCode.startsWith('FG-'));
        }
      }

      if (filtered.length === 0) {
        menuEl.innerHTML = `
          <div style="padding: 10px; text-align: center; color: #64748b; font-size: 11px;">
            No items matching "${query}".<br>
            <button type="button" class="btn btn-outline btn-xs" style="margin-top: 6px;" onclick="openItemMasterModalFor(${rowIndex}, '${tableType}')">
              <i class="fa-solid fa-list-check"></i> Browse Item Master
            </button>
          </div>
        `;
        return;
      }

      let html = `
        <div class="item-dropdown-header">
          <span>Item Master (${filtered.length} found)</span>
          <span style="font-weight: normal; cursor: pointer; color: var(--primary);" onclick="openItemMasterModalFor(${rowIndex}, '${tableType}')">
            <i class="fa-solid fa-up-right-from-square"></i> Full Master
          </span>
        </div>
      `;

      filtered.slice(0, 8).forEach(item => {
        let catClass = 'cat-rm';
        if (item.category === 'Packaging Material') catClass = 'cat-pm';
        else if (item.category === 'WIP') catClass = 'cat-wip';
        else if (item.category === 'Finished Goods') catClass = 'cat-fg';

        const rateStr = item.ratePerKG > 0 ? `NPR ${item.ratePerKG}/KG` : (item.ratePerUnit > 0 ? `NPR ${item.ratePerUnit}/${item.unit}` : '');
        const specStr = (item.widthMM > 0 && item.gsm > 0 && item.lengthMM > 0) ? ` · ${item.widthMM}×${item.gsm}×${item.lengthMM}` : '';

        html += `
          <div class="item-dropdown-item" onmousedown="onDropdownItemSelected(${rowIndex}, '${tableType}', '${item.itemCode}')">
            <div class="code-row">
              <span class="item-code-badge">${item.itemCode}</span>
              <span class="item-cat-badge ${catClass}">${item.category}</span>
            </div>
            <div class="name-text">${item.itemName}</div>
            <div class="specs-text">${rateStr} · Stock: ${(item.currentStock || 0).toLocaleString()} ${item.unit}${specStr}</div>
          </div>
        `;
      });

      menuEl.innerHTML = html;
    }

    function onDropdownItemSelected(rowIndex, tableType, itemCode) {
      const items = (state.itemMaster && state.itemMaster.length) ? state.itemMaster : mockItemMaster;
      const item = items.find(i => i.itemCode === itemCode);
      if (item) {
        selectMasterItemForRow(rowIndex, tableType, item);
      }
    }

    function closeAllItemDropdowns() {
      document.querySelectorAll('.item-dropdown-menu').forEach(m => m.style.display = 'none');
    }

    document.addEventListener('click', (e) => {
      if (!e.target.closest('.item-picker-cell') && !e.target.closest('.item-dropdown-menu')) {
        closeAllItemDropdowns();
      }
    });

    // Render Issue Rows
    function renderProductionIssueRows(rows) {
      const tbody = document.getElementById('tbodyProductionIssue');
      tbody.innerHTML = '';

      if (state.activeCategory === 'WIP') {
        rows.forEach((row, idx) => {
          const tr = document.createElement('tr');
          tr.dataset.index = idx;
          tr.innerHTML = `
            <td>
              <div class="item-picker-cell">
                <input type="text" class="table-input text-left input-itemcode" value="${row.itemCode || ''}" placeholder="Search code..." autocomplete="off" onfocus="showItemDropdown(this, ${idx}, 'wip_issue', 'code')" oninput="filterItemDropdown(this, ${idx}, 'wip_issue', 'code')">
                <button type="button" class="btn-item-browse-icon" onclick="openItemMasterModalFor(${idx}, 'wip_issue')" title="Search Item Master"><i class="fa-solid fa-magnifying-glass"></i></button>
                <div class="item-dropdown-menu" style="display: none;"></div>
              </div>
            </td>
            <td>
              <div class="item-picker-cell">
                <input type="text" class="table-input text-left input-itemname" value="${row.itemName || ''}" placeholder="Item description..." autocomplete="off" onfocus="showItemDropdown(this, ${idx}, 'wip_issue', 'name')" oninput="filterItemDropdown(this, ${idx}, 'wip_issue', 'name')">
                <div class="item-dropdown-menu" style="display: none;"></div>
              </div>
            </td>
            <td>
              <input type="number" step="any" class="table-input input-width" value="${row.width || 0}" oninput="recalcWIPRow(${idx})">
            </td>
            <td>
              <input type="number" step="any" class="table-input input-gsm" value="${row.gsm || 0}" oninput="recalcWIPRow(${idx})">
            </td>
            <td>
              <input type="number" step="any" class="table-input input-length" value="${row.length || 0}" oninput="recalcWIPRow(${idx})">
            </td>
            <td>
              <input type="number" step="any" class="table-input input-rate" value="${row.ratePerKG || 0}" oninput="recalcWIPRow(${idx})">
            </td>
            <td>
              <input type="number" step="any" class="table-input input-wt" style="background: #f0fdf4; font-weight: 700; color: #166534;" value="${row.weightPerPiece || 0}" oninput="recalcWIPRowFromWt(${idx})">
            </td>
            <td>
              <input type="number" step="any" class="table-input input-amount" readonly value="${row.expectedAmount || 0}">
            </td>
            <td style="text-align: center;">
              <button class="btn btn-danger btn-sm" onclick="removeIssueRow(${idx})" title="Remove"><i class="fa-solid fa-trash-can"></i></button>
            </td>
          `;
          tbody.appendChild(tr);
        });
      } else {
        // Finished Goods Issues
        rows.forEach((row, idx) => {
          const tr = document.createElement('tr');
          tr.dataset.index = idx;
          const isWip = !!row.isWIPReceiptItem;
          tr.innerHTML = `
            <td>
              ${isWip ? `
                <input type="text" class="table-input text-left input-fg-code" value="${row.itemCode || ''}" readonly style="background: #f8fafc; font-weight: bold;">
              ` : `
                <div class="item-picker-cell">
                  <input type="text" class="table-input text-left input-fg-code" value="${row.itemCode || ''}" placeholder="Search code..." autocomplete="off" onfocus="showItemDropdown(this, ${idx}, 'fg_issue', 'code')" oninput="filterItemDropdown(this, ${idx}, 'fg_issue', 'code')">
                  <button type="button" class="btn-item-browse-icon" onclick="openItemMasterModalFor(${idx}, 'fg_issue')" title="Search Item Master"><i class="fa-solid fa-magnifying-glass"></i></button>
                  <div class="item-dropdown-menu" style="display: none;"></div>
                </div>
              `}
            </td>
            <td>
              ${isWip ? `
                <input type="text" class="table-input text-left input-fg-name" value="${row.itemName || ''}" readonly style="background: #f8fafc; font-weight: bold;">
              ` : `
                <div class="item-picker-cell">
                  <input type="text" class="table-input text-left input-fg-name" value="${row.itemName || ''}" placeholder="Packaging / component..." autocomplete="off" onfocus="showItemDropdown(this, ${idx}, 'fg_issue', 'name')" oninput="filterItemDropdown(this, ${idx}, 'fg_issue', 'name')">
                  <div class="item-dropdown-menu" style="display: none;"></div>
                </div>
              `}
            </td>
            <td>
              <input type="text" class="table-input text-left input-fg-unit" style="text-align: center;" value="${row.unit || 'PCS'}" ${isWip ? 'readonly' : ''}>
            </td>
            <td>
              <input type="number" step="any" class="table-input input-fg-qty" value="${row.quantity || 0}" oninput="recalcFGRow(${idx})">
            </td>
            <td>
              <input type="number" step="any" class="table-input input-fg-amount" value="${row.amount || 0}" oninput="recalcFGRowManual(${idx})">
            </td>
            <td>
              <span style="font-size: 11px; color: ${isWip ? '#0369a1' : '#64748b'}; font-weight: ${isWip ? '700' : '400'};">
                ${isWip ? '<i class="fa-solid fa-link"></i> Linked WIP Production Receipt' : 'Inventory Valuation Rate'}
              </span>
            </td>
            <td style="text-align: center;">
              ${isWip ? '<span style="color: #94a3b8; font-size: 11px;">Fixed</span>' : `<button class="btn btn-danger btn-sm" onclick="removeIssueRow(${idx})" title="Remove"><i class="fa-solid fa-trash-can"></i></button>`}
            </td>
          `;
          tbody.appendChild(tr);
        });
      }

      updateTotalsAndReceiptSync();
    }

    // Add / Remove Issue Rows
    function addProductionIssueRow() {
      const isWIP = (state.activeCategory === 'WIP');
      const tbody = document.getElementById('tbodyProductionIssue');
      const idx = tbody.children.length;
      const tr = document.createElement('tr');
      tr.dataset.index = idx;

      if (isWIP) {
        tr.innerHTML = `
          <td>
            <div class="item-picker-cell">
              <input type="text" class="table-input text-left input-itemcode" value="" placeholder="Search code..." autocomplete="off" onfocus="showItemDropdown(this, ${idx}, 'wip_issue', 'code')" oninput="filterItemDropdown(this, ${idx}, 'wip_issue', 'code')">
              <button type="button" class="btn-item-browse-icon" onclick="openItemMasterModalFor(${idx}, 'wip_issue')" title="Search Item Master"><i class="fa-solid fa-magnifying-glass"></i></button>
              <div class="item-dropdown-menu" style="display: none;"></div>
            </div>
          </td>
          <td>
            <div class="item-picker-cell">
              <input type="text" class="table-input text-left input-itemname" value="" placeholder="Item description..." autocomplete="off" onfocus="showItemDropdown(this, ${idx}, 'wip_issue', 'name')" oninput="filterItemDropdown(this, ${idx}, 'wip_issue', 'name')">
              <div class="item-dropdown-menu" style="display: none;"></div>
            </div>
          </td>
          <td><input type="number" step="any" class="table-input input-width" value="0" oninput="recalcWIPRow(${idx})"></td>
          <td><input type="number" step="any" class="table-input input-gsm" value="0" oninput="recalcWIPRow(${idx})"></td>
          <td><input type="number" step="any" class="table-input input-length" value="0" oninput="recalcWIPRow(${idx})"></td>
          <td><input type="number" step="any" class="table-input input-rate" value="0" oninput="recalcWIPRow(${idx})"></td>
          <td><input type="number" step="any" class="table-input input-wt" style="background: #f0fdf4; font-weight: 700; color: #166534;" value="0" oninput="recalcWIPRowFromWt(${idx})"></td>
          <td><input type="number" step="any" class="table-input input-amount" readonly value="0"></td>
          <td style="text-align: center;"><button class="btn btn-danger btn-sm" onclick="removeIssueRow(${idx})" title="Remove"><i class="fa-solid fa-trash-can"></i></button></td>
        `;
      } else {
        tr.innerHTML = `
          <td>
            <div class="item-picker-cell">
              <input type="text" class="table-input text-left input-fg-code" value="" placeholder="Search code..." autocomplete="off" onfocus="showItemDropdown(this, ${idx}, 'fg_issue', 'code')" oninput="filterItemDropdown(this, ${idx}, 'fg_issue', 'code')">
              <button type="button" class="btn-item-browse-icon" onclick="openItemMasterModalFor(${idx}, 'fg_issue')" title="Search Item Master"><i class="fa-solid fa-magnifying-glass"></i></button>
              <div class="item-dropdown-menu" style="display: none;"></div>
            </div>
          </td>
          <td>
            <div class="item-picker-cell">
              <input type="text" class="table-input text-left input-fg-name" value="" placeholder="Packaging / component..." autocomplete="off" onfocus="showItemDropdown(this, ${idx}, 'fg_issue', 'name')" oninput="filterItemDropdown(this, ${idx}, 'fg_issue', 'name')">
              <div class="item-dropdown-menu" style="display: none;"></div>
            </div>
          </td>
          <td><input type="text" class="table-input text-left input-fg-unit" style="text-align: center;" value="PCS"></td>
          <td><input type="number" step="any" class="table-input input-fg-qty" value="1" oninput="recalcFGRow(${idx})"></td>
          <td><input type="number" step="any" class="table-input input-fg-amount" value="0" oninput="recalcFGRowManual(${idx})"></td>
          <td><span style="font-size: 11px; color: #64748b;">Inventory Stock & Valuation Rate</span></td>
          <td style="text-align: center;"><button class="btn btn-danger btn-sm" onclick="removeIssueRow(${idx})" title="Remove"><i class="fa-solid fa-trash-can"></i></button></td>
        `;
      }

      tbody.appendChild(tr);
    }

    function removeIssueRow(idx) {
      const tbody = document.getElementById('tbodyProductionIssue');
      if (tbody.children[idx]) {
        tbody.removeChild(tbody.children[idx]);
        Array.from(tbody.children).forEach((tr, newIdx) => {
          tr.dataset.index = newIdx;
        });
        updateTotalsAndReceiptSync();
      }
    }

    // Render Production Receipt Rows
    function renderProductionReceiptRows(rows) {
      const tbody = document.getElementById('tbodyProductionReceipt');
      tbody.innerHTML = '';

      if (!rows || rows.length === 0) {
        const baseQty = parseFloat(document.getElementById('inputBaseQty').value) || 1000;
        const baseUnit = document.getElementById('inputUnit').value || 'PCS';
        const pCode = document.getElementById('inputParentItemCode').value || (state.activeCategory === 'WIP' ? 'WIP-240-CORE' : 'FG-240-REG-10P');
        const pName = document.getElementById('inputProductName').value || (state.activeCategory === 'WIP' ? 'Core Pad Assembly' : 'Finished Goods Pack');
        rows = [{ itemCode: pCode, itemName: pName, unit: baseUnit, quantity: baseQty, amount: 0 }];
      }

      rows.forEach((r, idx) => {
        const tr = document.createElement('tr');
        tr.dataset.index = idx;
        tr.innerHTML = `
          <td>
            <div class="item-picker-cell">
              <input type="text" class="table-input text-left input-rec-code" value="${r.itemCode || ''}" placeholder="Receipt code..." autocomplete="off" onfocus="showItemDropdown(this, ${idx}, 'receipt', 'code')" oninput="filterItemDropdown(this, ${idx}, 'receipt', 'code')">
              <button type="button" class="btn-item-browse-icon" onclick="openItemMasterModalFor(${idx}, 'receipt')" title="Search Item Master"><i class="fa-solid fa-magnifying-glass"></i></button>
              <div class="item-dropdown-menu" style="display: none;"></div>
            </div>
          </td>
          <td>
            <div class="item-picker-cell">
              <input type="text" class="table-input text-left input-rec-name" value="${r.itemName || ''}" placeholder="Receipt item description..." autocomplete="off" onfocus="showItemDropdown(this, ${idx}, 'receipt', 'name')" oninput="filterItemDropdown(this, ${idx}, 'receipt', 'name')">
              <div class="item-dropdown-menu" style="display: none;"></div>
            </div>
          </td>
          <td><input type="text" class="table-input text-left input-rec-unit" style="text-align: center;" value="${r.unit || 'PCS'}"></td>
          <td><input type="number" step="any" class="table-input input-rec-qty" value="${r.quantity || 0}" oninput="updateTotalsAndReceiptSync()"></td>
          <td><input type="number" step="any" class="table-input input-rec-amount" value="${r.amount || 0}" oninput="updateTotalsAndReceiptSync()"></td>
          <td style="text-align: center;">
            <button class="btn btn-danger btn-sm" onclick="removeReceiptRow(${idx})" title="Remove"><i class="fa-solid fa-trash-can"></i></button>
          </td>
        `;
        tbody.appendChild(tr);
      });

      updateTotalsAndReceiptSync();
    }

    function addProductionReceiptRow() {
      const tbody = document.getElementById('tbodyProductionReceipt');
      const idx = tbody.children.length;
      const tr = document.createElement('tr');
      tr.dataset.index = idx;
      tr.innerHTML = `
        <td>
          <div class="item-picker-cell">
            <input type="text" class="table-input text-left input-rec-code" value="" placeholder="Receipt code..." autocomplete="off" onfocus="showItemDropdown(this, ${idx}, 'receipt', 'code')" oninput="filterItemDropdown(this, ${idx}, 'receipt', 'code')">
            <button type="button" class="btn-item-browse-icon" onclick="openItemMasterModalFor(${idx}, 'receipt')" title="Search Item Master"><i class="fa-solid fa-magnifying-glass"></i></button>
            <div class="item-dropdown-menu" style="display: none;"></div>
          </div>
