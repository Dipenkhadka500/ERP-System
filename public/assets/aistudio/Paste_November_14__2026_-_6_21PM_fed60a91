      var outCode = sel.value;
      var outName = opt ? opt.getAttribute('data-name') : '';
      var outQty = parseFloat(document.getElementById('bomOutputQty').value) || 1;

      var totalInput = 0;
      bomInputList.forEach(function(i) { totalInput += (parseFloat(i.qty) || 0) * (parseFloat(i.rate) || 0); });
