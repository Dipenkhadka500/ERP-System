    // Direct PDF Print Function (Works reliably in iframe and standalone windows)
    function printBOMToPDF() {
      const routineName = document.getElementById('inputRoutineName').value.trim() || 'BOM_Specification';
      const docHtml = `
        <!DOCTYPE html>
        <html>
        <head>
          <meta charset="utf-8">
          <title>${routineName} - Birat Healthcare BOM Specification</title>
          <style>
            @page {
              size: A4 portrait;
              margin: 12mm 15mm;
            }
