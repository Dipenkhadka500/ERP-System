    function calculateBOMTotals() {
      var totalInput = 0;
      bomInputList.forEach(function(i) {
        totalInput += (parseFloat(i.qty) || 0) * (parseFloat(i.rate) || 0);
      });
      document.getElementById('bomTotalInputCost').innerText = 'NPR ' + totalInput.toLocaleString(undefined, { minimumFractionDigits: 2 });
      var outQty = parseFloat(document.getElementById('bomOutputQty').value) || 1;
      var unitCost = totalInput / outQty;
      document.getElementById('bomCalculatedUnitCost').innerText = 'NPR ' + unitCost.toFixed(2) + ' / Unit';
    }

