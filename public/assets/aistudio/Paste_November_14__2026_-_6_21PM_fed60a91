    function renderReportTable(data) {
      var thead = document.getElementById('reportTableHead');
      var tbody = document.getElementById('reportTableBody');
      if (!data || data.length === 0) {
        thead.innerHTML = '';
        tbody.innerHTML = '<tr><td style="text-align:center; color:#94a3b8;">No records found for selected criteria.</td></tr>';
        return;
      }
      var headers = Object.keys(data[0]).filter(function(k) { return k !== '_row'; });
      thead.innerHTML = '<tr>' + headers.map(function(h) { return '<th>' + h + '</th>'; }).join('') + '</tr>';
      tbody.innerHTML = data.map(function(row) {
        return '<tr>' + headers.map(function(h) {
          var val = row[h];
          if (typeof val === 'object' && val !== null) val = JSON.stringify(val);
          return '<td>' + (val !== undefined ? val : '') + '</td>';
        }).join('') + '</tr>';
      }).join('');
    }

