    function calculateProductionBOMRequirements() {
      if (!state.currentProdBOM) return;

      const plannedQty = parseFloat(document.getElementById('prodQuantity').value) || 0;
      const baseQty = state.currentProdBOM.routine.baseQuantity || 1000;
      const ratio = plannedQty / baseQty;
      const isWIP = (state.currentProdBOM.routine.processCategory === 'WIP');

      // Top Table: Production Issue
      const tbodyIssue = document.getElementById('tbodyProdIssue');
      tbodyIssue.innerHTML = '';

      let totalBomIssue = 0;
      let totalActualIssue = 0;

      (state.currentProdBOM.issues || []).forEach((item, idx) => {
        const tr = document.createElement('tr');
        tr.dataset.index = idx;

        let bomQty = 0;
        let wt = item.weightPerPiece || 0;

        if (isWIP) {
          bomQty = (wt * plannedQty) / 1000;
        } else {
          bomQty = (item.quantity || 0) * ratio;
        }
        bomQty = parseFloat(bomQty.toFixed(3));
        const actualQty = bomQty;

        totalBomIssue += bomQty;
        totalActualIssue += actualQty;

        tr.innerHTML = `
          <td><b>${item.itemCode}</b></td>
          <td>${item.itemName}</td>
          <td style="text-align: center;">${isWIP ? 'KG' : (item.unit || 'PCS')}</td>
          <td style="text-align: right;" class="prod-bom-qty">${bomQty.toFixed(3)}</td>
          <td style="text-align: right;">
            ${isWIP ? `<input type="number" step="0.001" class="table-input prod-wt-input" value="${wt.toFixed(4)}" oninput="onProdWeightChanged(${idx})">` : '-'}
          </td>
          <td>
            <input type="number" step="0.001" class="table-input prod-act-issue-input" style="background: #eff6ff; font-weight: 700;" value="${actualQty.toFixed(3)}" oninput="onProdActualIssueChanged(${idx})">
          </td>
          <td style="text-align: right;" class="prod-issue-variance">
            <span class="variance-zero">0.000</span>
          </td>
          <td><input type="text" class="table-input text-left prod-issue-remark" placeholder="OK"></td>
        `;
        tbodyIssue.appendChild(tr);
      });

      document.getElementById('prodTotalBomIssueQty').innerText = totalBomIssue.toFixed(3);
      document.getElementById('prodTotalActualIssueQty').innerText = totalActualIssue.toFixed(3);
      document.getElementById('prodTotalVarianceIssueQty').innerHTML = `<span class="variance-zero">0.000</span>`;

      // Bottom Table: Production Receipt
      const tbodyReceipt = document.getElementById('tbodyProdReceipt');
      tbodyReceipt.innerHTML = '';

      let totalBomRec = 0;
      let totalActualRec = 0;

      (state.currentProdBOM.receipts || []).forEach((r, idx) => {
        const tr = document.createElement('tr');
        tr.dataset.index = idx;

        const bomReceiptQty = (r.quantity || baseQty) * ratio;
        const actualReceiptQty = bomReceiptQty;

        totalBomRec += bomReceiptQty;
        totalActualRec += actualReceiptQty;

        tr.innerHTML = `
          <td><b>${r.itemCode}</b></td>
          <td>${r.itemName}</td>
          <td style="text-align: center;">${r.unit || state.currentProdBOM.routine.unit}</td>
          <td style="text-align: right;" class="prod-bom-rec-qty">${bomReceiptQty.toLocaleString()}</td>
          <td>
            <input type="number" step="1" class="table-input prod-act-rec-input" style="background: #f0fdf4; font-weight: 700; color: #166534;" value="${actualReceiptQty}" oninput="onProdActualReceiptChanged(${idx})">
          </td>
          <td style="text-align: right;" class="prod-rec-variance">
            <span class="variance-zero">0</span>
          </td>
          <td><input type="text" class="table-input text-left prod-rec-remark" placeholder="Good Output"></td>
        `;
        tbodyReceipt.appendChild(tr);
      });

      document.getElementById('prodTotalBomReceiptQty').innerText = totalBomRec.toLocaleString();
      document.getElementById('prodTotalActualReceiptQty').innerText = totalActualRec.toLocaleString();
      document.getElementById('prodTotalVarianceReceiptQty').innerHTML = `<span class="variance-zero">0</span>`;
    }

    function onProdWeightChanged(idx) {
      const rows = document.querySelectorAll('#tbodyProdIssue tr');
      if (!rows[idx]) return;

      const plannedQty = parseFloat(document.getElementById('prodQuantity').value) || 0;
      const customWt = parseFloat(rows[idx].querySelector('.prod-wt-input').value) || 0;
      const bomQty = parseFloat(rows[idx].querySelector('.prod-bom-qty').innerText) || 0;

      const newActualQty = (customWt * plannedQty) / 1000;
      rows[idx].querySelector('.prod-act-issue-input').value = newActualQty.toFixed(3);

      updateIssueVariance(rows[idx], bomQty, newActualQty);
      recalculateProdIssueTotals();
    }

    function onProdActualIssueChanged(idx) {
      const rows = document.querySelectorAll('#tbodyProdIssue tr');
      if (!rows[idx]) return;

      const bomQty = parseFloat(rows[idx].querySelector('.prod-bom-qty').innerText) || 0;
      const actualQty = parseFloat(rows[idx].querySelector('.prod-act-issue-input').value) || 0;

      updateIssueVariance(rows[idx], bomQty, actualQty);
      recalculateProdIssueTotals();
    }

    function updateIssueVariance(rowElement, bomQty, actualQty) {
      const variance = actualQty - bomQty;
      const varCell = rowElement.querySelector('.prod-issue-variance');

      if (Math.abs(variance) < 0.0001) {
        varCell.innerHTML = `<span class="variance-zero">0.000</span>`;
      } else if (variance > 0) {
        varCell.innerHTML = `<span class="variance-pos">+${variance.toFixed(3)} (Over)</span>`;
      } else {
        varCell.innerHTML = `<span class="variance-neg">${variance.toFixed(3)} (Saved)</span>`;
      }
    }

    function recalculateProdIssueTotals() {
      let totalBom = 0;
      let totalActual = 0;
      let totalVar = 0;

      const rows = document.querySelectorAll('#tbodyProdIssue tr');
      rows.forEach(r => {
        const b = parseFloat(r.querySelector('.prod-bom-qty').innerText) || 0;
        const a = parseFloat(r.querySelector('.prod-act-issue-input').value) || 0;
        totalBom += b;
        totalActual += a;
        totalVar += (a - b);
      });

      document.getElementById('prodTotalBomIssueQty').innerText = totalBom.toFixed(3);
      document.getElementById('prodTotalActualIssueQty').innerText = totalActual.toFixed(3);

      const varSpan = document.getElementById('prodTotalVarianceIssueQty');
      if (Math.abs(totalVar) < 0.0001) {
        varSpan.innerHTML = `<span class="variance-zero">0.000</span>`;
      } else if (totalVar > 0) {
        varSpan.innerHTML = `<span class="variance-pos">+${totalVar.toFixed(3)}</span>`;
      } else {
        varSpan.innerHTML = `<span class="variance-neg">${totalVar.toFixed(3)}</span>`;
      }
    }

    function onProdActualReceiptChanged(idx) {
      const rows = document.querySelectorAll('#tbodyProdReceipt tr');
      if (!rows[idx]) return;

      const bomQty = parseFloat(rows[idx].querySelector('.prod-bom-rec-qty').innerText.replace(/,/g, '')) || 0;
      const actQty = parseFloat(rows[idx].querySelector('.prod-act-rec-input').value) || 0;
      const variance = actQty - bomQty;

      const varCell = rows[idx].querySelector('.prod-rec-variance');
      if (variance === 0) {
        varCell.innerHTML = `<span class="variance-zero">0</span>`;
      } else if (variance > 0) {
        varCell.innerHTML = `<span class="variance-zero" style="color: #15803d; font-weight: 700;">+${variance} (Surplus)</span>`;
      } else {
        varCell.innerHTML = `<span class="variance-pos">${variance} (Shortage)</span>`;
      }

      recalculateProdReceiptTotals();
    }

    function recalculateProdReceiptTotals() {
      let totalBom = 0;
      let totalActual = 0;
      let totalVar = 0;

      const rows = document.querySelectorAll('#tbodyProdReceipt tr');
      rows.forEach(r => {
        const b = parseFloat(r.querySelector('.prod-bom-rec-qty').innerText.replace(/,/g, '')) || 0;
        const a = parseFloat(r.querySelector('.prod-act-rec-input').value) || 0;
        totalBom += b;
        totalActual += a;
        totalVar += (a - b);
      });

      document.getElementById('prodTotalBomReceiptQty').innerText = totalBom.toLocaleString();
      document.getElementById('prodTotalActualReceiptQty').innerText = totalActual.toLocaleString();

      const varSpan = document.getElementById('prodTotalVarianceReceiptQty');
      if (totalVar === 0) {
        varSpan.innerHTML = `<span class="variance-zero">0</span>`;
      } else if (totalVar > 0) {
        varSpan.innerHTML = `<span class="variance-zero" style="color: #15803d; font-weight: 700;">+${totalVar}</span>`;
      } else {
        varSpan.innerHTML = `<span class="variance-pos">${totalVar}</span>`;
      }
    }

    async function saveProductionRecord() {
      if (!state.currentProdBOM) {
        showBOMToast('Please select a routine first', 'error');
        return;
      }

      const prodDate = document.getElementById('prodDate').value;
      if (!prodDate) {
        showBOMToast('Please select Date of Production', 'error');
        return;
      }

      const issueRows = document.querySelectorAll('#tbodyProdIssue tr');
      const issues = Array.from(issueRows).map((r, i) => {
        const item = state.currentProdBOM.issues[i] || {};
        return {
          itemCode: item.itemCode,
          itemName: item.itemName,
          unit: state.currentProdBOM.routine.processCategory === 'WIP' ? 'KG' : (item.unit || 'PCS'),
          bomQuantity: parseFloat(r.querySelector('.prod-bom-qty').innerText) || 0,
          actualQuantity: parseFloat(r.querySelector('.prod-act-issue-input').value) || 0,
          weightPerPiece: r.querySelector('.prod-wt-input') ? (parseFloat(r.querySelector('.prod-wt-input').value) || 0) : 0,
          rate: item.ratePerKG || 0,
          remarks: r.querySelector('.prod-issue-remark').value
        };
      });

      const receiptRows = document.querySelectorAll('#tbodyProdReceipt tr');
      const receipts = Array.from(receiptRows).map((r, i) => {
        const rec = state.currentProdBOM.receipts[i] || {};
        return {
          itemCode: rec.itemCode,
          itemName: rec.itemName,
          unit: rec.unit || state.currentProdBOM.routine.unit,
          bomQuantity: parseFloat(r.querySelector('.prod-bom-rec-qty').innerText.replace(/,/g, '')) || 0,
          actualQuantity: parseFloat(r.querySelector('.prod-act-rec-input').value) || 0,
          remarks: r.querySelector('.prod-rec-remark').value
        };
