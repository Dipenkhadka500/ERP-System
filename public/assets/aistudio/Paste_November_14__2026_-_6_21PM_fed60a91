    .kpi-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px; }
    .kpi-title { font-size: 0.78rem; text-transform: uppercase; font-weight: 700; color: var(--text-muted); letter-spacing: 0.5px; }
