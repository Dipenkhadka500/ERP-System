    // Google Apps Script Call Bridge
    function callBOMServer(functionName, ...args) {
      return new Promise((resolve, reject) => {
        if (typeof google !== 'undefined' && google.script && google.script.run) {
          google.script.run
            .withSuccessHandler(resolve)
            .withFailureHandler(reject)
            [functionName](...args);
        } else {
          // Simulation fallback for browser preview
          setTimeout(() => {
            handleMockServerCall(functionName, args, resolve, reject);
          }, 150);
        }
      });
    }

    function handleMockServerCall(fn, args, resolve, reject) {
      let currentRoutines = getStoredRoutines();

      if (fn === 'getItemMaster') {
        resolve(mockItemMaster);
      } else if (fn === 'getInventoryValuation') {
        resolve(mockInventory);
      } else if (fn === 'getBOMRoutines') {
        const cat = args[0];
        let list = cat ? currentRoutines.filter(r => r.processCategory.toLowerCase() === cat.toLowerCase()) : currentRoutines;
        list.sort((a, b) => a.routineName.localeCompare(b.routineName));
        resolve(list);
      } else if (fn === 'getBOMDetails') {
        const routineId = args[0];
        const saved = getStoredBOMDetails(routineId);
        if (saved) {
          resolve(saved);
          return;
        }

        const r = currentRoutines.find(x => x.routineId === routineId) || currentRoutines[0];
        const isWIP = (r.processCategory === 'WIP');
        const details = isWIP ? {
          routine: r,
          issues: JSON.parse(JSON.stringify(standardWIPMaterials)),
          receipts: [{ receiptId: 'REC-01', itemCode: r.parentItemCode, itemName: r.productName, unit: r.unit, quantity: r.baseQuantity, amount: 1662.03 }]
        } : {
          routine: r,
          issues: [
            { issueId: 'FG-ISS-01', itemCode: 'WIP-240-CORE', itemName: '240mm Core Pad', unit: 'PCS', quantity: 1000, amount: 1662.03, isWIPReceiptItem: true, linkedWIPRoutineId: 'RT-WIP-240-001', remarks: 'From WIP Receipt' },
            { issueId: 'FG-ISS-02', itemCode: 'PM-PC-010', itemName: 'Printed Outer Pouch', unit: 'PCS', quantity: 100, amount: 450.00, isWIPReceiptItem: false, linkedWIPRoutineId: '', remarks: 'Packaging' }
          ],
          receipts: [{ receiptId: 'REC-01', itemCode: r.parentItemCode, itemName: r.productName, unit: r.unit, quantity: r.baseQuantity, amount: 2112.03 }]
        };
        saveStoredBOMDetails(routineId, details);
        resolve(details);
      } else if (fn === 'saveWIPBOM' || fn === 'saveFGBOM') {
        const payload = args[0];
        const isNew = (!payload.routineId || payload.routineId === 'NEW' || payload.routineId.includes('DRAFT'));
        const routineId = isNew ? ((payload.processCategory === 'WIP' ? 'RT-WIP-' : 'RT-FG-') + Date.now()) : payload.routineId;
        const autoRoutineName = 'RT-' + payload.bomName.replace(/^RT-/, '').trim();

        const newRoutine = {
          routineId: routineId,
          routineName: autoRoutineName,
          bomName: payload.bomName.replace(/^RT-/, '').trim(),
          processCategory: (fn === 'saveWIPBOM') ? 'WIP' : 'Finished Goods',
          parentItemCode: payload.parentItemCode || '',
          productName: payload.productName || payload.bomName,
          baseQuantity: Number(payload.baseQuantity) || 1000,
          unit: payload.unit || 'PCS',
          linkedWIPRoutineId: payload.linkedWIPRoutineId || '',
          effectiveDate: payload.effectiveDate || new Date().toISOString().substring(0, 10),
          status: 'Active',
          revision: 'Rev 1.0',
          description: payload.description || ''
        };

        const existingIdx = currentRoutines.findIndex(r => r.routineId === routineId);
        if (existingIdx >= 0) {
          currentRoutines[existingIdx] = newRoutine;
        } else {
          currentRoutines.push(newRoutine);
        }
        saveStoredRoutines(currentRoutines);

        const details = {
          routine: newRoutine,
          issues: payload.issues || [],
          receipts: payload.receipts || []
        };
        saveStoredBOMDetails(routineId, details);

        resolve({
          success: true,
          message: 'BOM saved successfully as ' + autoRoutineName,
          routineId: routineId,
          routineName: autoRoutineName
        });
      } else if (fn === 'deleteBOM') {
        const routineId = args[0];
        currentRoutines = currentRoutines.filter(r => r.routineId !== routineId);
        saveStoredRoutines(currentRoutines);
        resolve({ success: true, message: 'Routine deleted successfully.' });
      } else if (fn === 'saveProductionRun') {
        resolve({
          success: true,
          runId: 'RUN-' + Date.now(),
          message: 'Production Issue and Receipt recorded successfully on ' + args[0].productionDate
        });
      } else if (fn === 'getProductionRuns') {
        resolve([
          {
            runId: 'RUN-20261112-1001',
            productionDate: '2026-11-12',
            routineId: 'RT-WIP-240-001',
            routineName: 'RT-240MM REGULAR STRAIGHT WIP',
            processCategory: 'WIP',
            plannedQuantity: 5000,
            unit: 'PCS',
            status: 'Completed',
            totalIssueVariance: 0.125,
            totalReceiptVariance: -20,
            recordedBy: 'Dipen Khadka'
          }
        ]);
      } else {
        resolve({ success: true });
      }
    }

