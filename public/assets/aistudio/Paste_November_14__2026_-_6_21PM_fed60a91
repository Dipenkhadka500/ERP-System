        <td><input type="text" class="table-input text-left input-rec-unit" style="text-align: center;" value="PCS"></td>
        <td><input type="number" step="any" class="table-input input-rec-qty" value="1000" oninput="updateTotalsAndReceiptSync()"></td>
        <td><input type="number" step="any" class="table-input input-rec-amount" value="0" oninput="updateTotalsAndReceiptSync()"></td>
        <td style="text-align: center;"><button class="btn btn-danger btn-sm" onclick="removeReceiptRow(${idx})" title="Remove"><i class="fa-solid fa-trash-can"></i></button></td>
      `;
      tbody.appendChild(tr);
      updateTotalsAndReceiptSync();
    }

    function removeReceiptRow(idx) {
      const tbody = document.getElementById('tbodyProductionReceipt');
      if (tbody.children[idx]) {
        tbody.removeChild(tbody.children[idx]);
        updateTotalsAndReceiptSync();
      }
    }

    // Synchronize totals and default receipt amount from total issues
    function updateTotalsAndReceiptSync() {
      const isWIP = (state.activeCategory === 'WIP');
      let totalIssueAmt = 0;
      let totalIssueWeight = 0;

      const issueRows = document.querySelectorAll('#tbodyProductionIssue tr');
      issueRows.forEach(r => {
        if (isWIP) {
          const amt = parseFloat(r.querySelector('.input-amount').value) || 0;
          const wt = parseFloat(r.querySelector('.input-wt').value) || 0;
          totalIssueAmt += amt;
          totalIssueWeight += wt;
        } else {
          const amt = parseFloat(r.querySelector('.input-fg-amount').value) || 0;
          totalIssueAmt += amt;
        }
      });

      // Update Issue Footer
      const tfootIssue = document.getElementById('tfootProductionIssue');
      if (isWIP) {
        tfootIssue.innerHTML = `
          <td colspan="6" style="text-align: right;">Total Expected Material Cost:</td>
          <td style="text-align: right; background: #ecfdf5; font-weight: 700; color: #166534;">${totalIssueWeight.toFixed(4)} g/pc</td>
          <td style="text-align: right; color: var(--primary); font-size: 14px;">NPR ${totalIssueAmt.toFixed(2)}</td>
          <td></td>
        `;
      } else {
        tfootIssue.innerHTML = `
          <td colspan="4" style="text-align: right;">Total Finished Goods Component Cost:</td>
          <td style="text-align: right; color: var(--primary); font-size: 14px;">NPR ${totalIssueAmt.toFixed(2)}</td>
          <td colspan="2"></td>
        `;
      }

      // Sync to first receipt item amount if available
      const receiptRows = document.querySelectorAll('#tbodyProductionReceipt tr');
      let totalRecQty = 0;
      let totalRecAmt = 0;

      receiptRows.forEach((rr, idx) => {
        const q = parseFloat(rr.querySelector('.input-rec-qty').value) || 0;
        let a = parseFloat(rr.querySelector('.input-rec-amount').value);
        if (idx === 0 && (isNaN(a) || a === 0 || a === totalIssueAmt)) {
          rr.querySelector('.input-rec-amount').value = totalIssueAmt.toFixed(2);
          a = totalIssueAmt;
        }
        totalRecQty += q;
        totalRecAmt += (a || 0);
      });

      document.getElementById('totalReceiptQty').innerText = totalRecQty.toLocaleString();
      document.getElementById('totalReceiptAmount').innerText = 'NPR ' + totalRecAmt.toFixed(2);
    }

    // Linked WIP Routine for Finished Goods BOM
    async function onLinkedWIPChanged() {
      const wipRoutineId = document.getElementById('selectLinkedWIPRoutine').value;
      if (!wipRoutineId) return;

      try {
        const wipData = await callBOMServer('getBOMDetails', wipRoutineId);
        if (!wipData || !wipData.receipts || wipData.receipts.length === 0) {
          showBOMToast('Selected WIP routine does not have a production receipt item.', 'error');
          return;
        }

        const wipReceipt = wipData.receipts[0];
        const fgQtyRequired = parseFloat(document.getElementById('inputBaseQty').value) * 10;

        let currentIssues = getTableData('FG_ISSUE');
        const remainingIssues = currentIssues.filter(i => !i.isWIPReceiptItem);

        const linkedItem = {
          itemCode: wipReceipt.itemCode,
          itemName: wipReceipt.itemName,
          unit: wipReceipt.unit || 'PCS',
          quantity: wipReceipt.quantity || fgQtyRequired,
          amount: wipReceipt.amount,
          isWIPReceiptItem: true,
          linkedWIPRoutineId: wipRoutineId,
          remarks: 'From WIP Production Receipt of ' + wipData.routine.routineName
        };

        renderProductionIssueRows([linkedItem, ...remainingIssues]);
        showBOMToast('Linked WIP Core Pad output referenced in Production Issue.', 'success');
      } catch (err) {
        showBOMToast('Error fetching linked WIP receipt: ' + err.message, 'error');
      }
    }

    // Helper: read table rows
    function getTableData(type) {
      if (type === 'WIP_ISSUE') {
        const rows = document.querySelectorAll('#tbodyProductionIssue tr');
        return Array.from(rows).map(r => ({
          itemCode: r.querySelector('.input-itemcode').value.trim(),
          itemName: r.querySelector('.input-itemname').value.trim(),
          width: parseFloat(r.querySelector('.input-width').value) || 0,
          gsm: parseFloat(r.querySelector('.input-gsm').value) || 0,
          length: parseFloat(r.querySelector('.input-length').value) || 0,
          ratePerKG: parseFloat(r.querySelector('.input-rate').value) || 0,
          weightPerPiece: parseFloat(r.querySelector('.input-wt').value) || 0,
          expectedAmount: parseFloat(r.querySelector('.input-amount').value) || 0
        }));
      } else if (type === 'FG_ISSUE') {
        const rows = document.querySelectorAll('#tbodyProductionIssue tr');
        return Array.from(rows).map(r => ({
          itemCode: r.querySelector('.input-fg-code').value.trim(),
          itemName: r.querySelector('.input-fg-name').value.trim(),
          unit: r.querySelector('.input-fg-unit').value.trim(),
          quantity: parseFloat(r.querySelector('.input-fg-qty').value) || 0,
          amount: parseFloat(r.querySelector('.input-fg-amount').value) || 0,
          isWIPReceiptItem: r.querySelector('.input-fg-code').readOnly
        }));
      } else if (type === 'RECEIPT') {
        const rows = document.querySelectorAll('#tbodyProductionReceipt tr');
        return Array.from(rows).map(r => ({
          itemCode: r.querySelector('.input-rec-code').value.trim(),
          itemName: r.querySelector('.input-rec-name').value.trim(),
          unit: r.querySelector('.input-rec-unit').value.trim(),
          quantity: parseFloat(r.querySelector('.input-rec-qty').value) || 0,
          amount: parseFloat(r.querySelector('.input-rec-amount').value) || 0
        }));
      }
    }

    // Save BOM Setup to Google Apps Script backend
    async function saveBOM() {
      const bomName = document.getElementById('inputBomName').value.trim();
      if (!bomName) {
        showBOMToast('Please enter a BOM Name', 'error');
        return;
      }

      const isWIP = (state.activeCategory === 'WIP');
      const payload = {
        routineId: state.currentRoutineId,
        bomName: bomName,
        routineName: document.getElementById('inputRoutineName').value.trim(),
        parentItemCode: document.getElementById('inputParentItemCode').value.trim(),
        productName: document.getElementById('inputProductName').value.trim(),
        baseQuantity: parseFloat(document.getElementById('inputBaseQty').value) || (isWIP ? 1000 : 100),
        unit: document.getElementById('inputUnit').value,
        effectiveDate: document.getElementById('inputEffectiveDate').value,
        linkedWIPRoutineId: isWIP ? '' : document.getElementById('selectLinkedWIPRoutine').value,
        issues: getTableData(isWIP ? 'WIP_ISSUE' : 'FG_ISSUE'),
        receipts: getTableData('RECEIPT')
      };

      try {
        const result = isWIP ? await callBOMServer('saveWIPBOM', payload) : await callBOMServer('saveFGBOM', payload);
        showBOMToast(result.message, 'success');
        await loadRoutines();
        state.currentRoutineId = result.routineId;
        populateRoutineSelector(result.routineId);
      } catch (err) {
        showBOMToast('Save failed: ' + err.message, 'error');
      }
    }

    // Delete BOM Routine
    async function deleteCurrentBOM() {
      if (!state.currentRoutineId || state.currentRoutineId === 'NEW') {
        showBOMToast('No saved routine to delete', 'error');
        return;
      }
      if (!confirm('Are you sure you want to delete routine ' + document.getElementById('inputRoutineName').value + '?')) {
        return;
      }

      try {
        const res = await callBOMServer('deleteBOM', state.currentRoutineId);
        showBOMToast(res.message, 'success');
        state.currentRoutineId = null;
        await loadRoutines();
      } catch (err) {
        showBOMToast('Delete failed: ' + err.message, 'error');
      }
    }

