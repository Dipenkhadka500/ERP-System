    async function onProductionRoutineSelected() {
      const routineId = document.getElementById('prodRoutineSelector').value;
      if (!routineId) return;

      try {
        const bomData = await callBOMServer('getBOMDetails', routineId);
        state.currentProdBOM = bomData;
