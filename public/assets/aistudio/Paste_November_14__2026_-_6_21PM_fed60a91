        var lineTotal = (parseFloat(itm.qty) || 0) * (parseFloat(itm.rate) || 0);
        return '<tr>' +
          '<td><input type="text" class="form-control" value="' + itm.itemCode + '" onchange="quoteItems[' + idx + '].itemCode=this.value" style="padding:4px 8px;"></td>' +
