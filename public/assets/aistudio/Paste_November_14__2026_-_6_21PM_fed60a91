    function renderBOMInputTable() {
      var tbody = document.getElementById('bomInputTableBody');
      tbody.innerHTML = bomInputList.map(function(inp, idx) {
        var tot = (parseFloat(inp.qty) || 0) * (parseFloat(inp.rate) || 0);
        return '<tr>' +
