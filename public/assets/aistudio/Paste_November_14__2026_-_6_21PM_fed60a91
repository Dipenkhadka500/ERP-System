        processCategory: state.currentProdBOM.routine.processCategory,
        plannedQuantity: parseFloat(document.getElementById('prodQuantity').value) || 0,
        unit: state.currentProdBOM.routine.unit,
        recordedBy: document.getElementById('prodSupervisor').value,
        issues: issues,
        receipts: receipts
      };

      try {
        const res = await callBOMServer('saveProductionRun', payload);
        showBOMToast(res.message, 'success');
        await loadProductionRuns();
      } catch (err) {
        showBOMToast('Failed to save production record: ' + err.message, 'error');
      }
