function initializeDatabase(lockAlreadyHeld) {
  var lock = LockService.getScriptLock();
  if (!lockAlreadyHeld) lock.waitLock(30000);

  try {
    var ss = getTargetSpreadsheet();

    var schemas = {
      'BOM_Routines': [
        'RoutineID', 'RoutineName', 'BOMName', 'ProcessCategory', 'ParentItemCode',
        'ProductName', 'BaseQuantity', 'Unit', 'LinkedWIPRoutineID', 'EffectiveDate',
        'Status', 'Revision', 'Description', 'CreatedAt', 'UpdatedAt'
      ],
      'BOM_WIP_Issues': [
        'IssueID', 'RoutineID', 'ItemCode', 'ItemName', 'WidthMM',
        'GSM', 'LengthMM', 'RatePerKG', 'WeightPerPieceGrams', 'ExpectedAmountNPR', 'Remarks'
      ],
      'BOM_WIP_Receipts': [
        'ReceiptID', 'RoutineID', 'ItemCode', 'ItemName', 'Unit', 'Quantity', 'AmountNPR'
      ],
      'BOM_FG_Issues': [
        'IssueID', 'RoutineID', 'ItemCode', 'ItemName', 'Unit',
        'Quantity', 'AmountNPR', 'IsWIPReceiptItem', 'LinkedWIPRoutineID', 'Remarks'
      ],
      'BOM_FG_Receipts': [
        'ReceiptID', 'RoutineID', 'ItemCode', 'ItemName', 'Unit', 'Quantity', 'AmountNPR'
      ],
      'Item_Master': [
        'ItemCode', 'ItemName', 'Category', 'Unit', 'WidthMM', 'GSM', 'LengthMM',
        'RatePerKG', 'RatePerUnit', 'CurrentStock', 'Status', 'Description'
      ],
      'Inventory_Valuation': [
        'ItemCode', 'ItemName', 'Category', 'Unit', 'CurrentStock',
        'ValuationRatePerKG', 'ValuationRatePerUnit', 'LastPurchaseDate', 'Status'
      ],
      'Production_Runs': [
        'RunID', 'ProductionDate', 'RoutineID', 'RoutineName', 'ProcessCategory',
        'PlannedQuantity', 'Unit', 'Status', 'TotalIssueVariance', 'TotalReceiptVariance',
        'RecordedAt', 'RecordedBy', 'Remarks'
      ],
      'Production_Run_Issues': [
        'RunIssueID', 'RunID', 'ItemCode', 'ItemName', 'Unit',
        'BOMQuantity', 'ActualQuantity', 'VarianceQuantity', 'WeightPerPiece', 'Rate', 'Remarks'
      ],
      'Production_Run_Receipts': [
        'RunReceiptID', 'RunID', 'ItemCode', 'ItemName', 'Unit',
        'BOMQuantity', 'ActualQuantity', 'VarianceQuantity', 'Remarks'
      ]
    };

    var brandColors = {
      headerBg: '#0f291e',
      headerFont: '#ffffff'
    };

    for (var sheetName in schemas) {
      var sheet = ss.getSheetByName(sheetName);
      var headers = schemas[sheetName];

      if (!sheet) {
        sheet = ss.insertSheet(sheetName);
        sheet.appendRow(headers);
        var headerRange = sheet.getRange(1, 1, 1, headers.length);
        headerRange.setBackground(brandColors.headerBg);
        headerRange.setFontColor(brandColors.headerFont);
        headerRange.setFontWeight('bold');
        headerRange.setHorizontalAlignment('center');
        sheet.setFrozenRows(1);
      } else {
        var existingHeaders = sheet.getRange(1, 1, 1, Math.max(sheet.getLastColumn(), 1)).getValues()[0];
        if (existingHeaders.length === 0 || existingHeaders[0] === '') {
          sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
          var hr = sheet.getRange(1, 1, 1, headers.length);
          hr.setBackground(brandColors.headerBg);
          hr.setFontColor(brandColors.headerFont);
          hr.setFontWeight('bold');
          sheet.setFrozenRows(1);
        }
      }
    }

    // Seed Item Master and Inventory Valuation if empty
    seedItemMaster(ss);
    seedInventoryValuation(ss);

    // Seed default WIP and FG Routines if empty
    seedDefaultBOMs(ss);

    return {
      success: true,
      message: 'Database sheets successfully initialized and verified.',
      sheets: Object.keys(schemas)
    };
  } catch (err) {
    throw new Error('Database initialization failed: ' + err.message);
  } finally {
    lock.releaseLock();
  }
}

