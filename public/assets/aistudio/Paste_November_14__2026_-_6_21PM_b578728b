function getBOMRoutines(category) {
  try {
    var ss = getTargetSpreadsheet();
    var sheet = ss.getSheetByName('BOM_Routines');
    if (!sheet) {
      initializeDatabase();
      sheet = ss.getSheetByName('BOM_Routines');
    }

    var data = sheet.getDataRange().getValues();
    if (data.length <= 1) return [];

    var routines = [];
    for (var i = 1; i < data.length; i++) {
      var row = data[i];
      if (!row[0]) continue;

      var rCategory = String(row[3]);
      if (category && rCategory.toLowerCase() !== category.toLowerCase()) {
        continue;
      }

      routines.push({
        routineId: String(row[0]),
        routineName: String(row[1]),
        bomName: String(row[2]),
        processCategory: rCategory,
        parentItemCode: String(row[4]),
        productName: String(row[5]),
        baseQuantity: Number(row[6]) || 1000,
        unit: String(row[7] || 'PCS'),
        linkedWIPRoutineId: String(row[8] || ''),
        effectiveDate: row[9] ? formatDateString(row[9]) : '',
        status: String(row[10] || 'Active'),
        revision: String(row[11] || 'Rev 1.0'),
        description: String(row[12] || ''),
        createdAt: row[13] ? formatDateString(row[13]) : '',
        updatedAt: row[14] ? formatDateString(row[14]) : ''
      });
    }

    // Sort alphabetically by routine name for 100+ routines
    routines.sort(function(a, b) {
      return a.routineName.localeCompare(b.routineName);
    });

    return routines;
  } catch (err) {
    throw new Error('Error loading BOM routines: ' + err.message);
  }
}

function getBOMDetails(routineId) {
  try {
    var ss = getTargetSpreadsheet();
    var routineSheet = ss.getSheetByName('BOM_Routines');
    var routineRows = routineSheet.getDataRange().getValues();
    var routine = null;

    for (var i = 1; i < routineRows.length; i++) {
      if (String(routineRows[i][0]) === routineId) {
        var r = routineRows[i];
        routine = {
          routineId: String(r[0]),
          routineName: String(r[1]),
          bomName: String(r[2]),
          processCategory: String(r[3]),
          parentItemCode: String(r[4]),
          productName: String(r[5]),
          baseQuantity: Number(r[6]) || 1000,
          unit: String(r[7] || 'PCS'),
          linkedWIPRoutineId: String(r[8] || ''),
          effectiveDate: r[9] ? formatDateString(r[9]) : '',
          status: String(r[10] || 'Active'),
          revision: String(r[11] || 'Rev 1.0'),
          description: String(r[12] || '')
