/**
 * Audit Logging Helper
 */
function logAudit(action, module, recordId, details, userEmail) {
  try {
    var ss = getDatabase();
    var sheet = ss.getSheetByName('AuditLog');
    if (!sheet) return;
    var email = userEmail || Session.getActiveUser().getEmail() || 'system';
    sheet.appendRow([
      'LOG-' + Utilities.getUuid().substring(0, 8).toUpperCase(),
      new Date().toISOString(),
      email,
      action,
      module,
      recordId || '',
      typeof details === 'object' ? JSON.stringify(details) : String(details)
    ]);
  } catch (e) {
    Logger.log('Audit log error: ' + e.toString());
  }
}

/**
 * Bootstrap Application Data: Returns user profile, permissions, active settings & exchange rates
 */
function getBootstrap() {
  var ss = getDatabase();
  var userEmail = Session.getActiveUser().getEmail() || 'dipen.khadka@birathealthcare.com';

  // Load Settings
  var settings = {};
  var setSheet = ss.getSheetByName('Settings');
  if (setSheet && setSheet.getLastRow() > 1) {
    var setVals = setSheet.getRange(2, 1, setSheet.getLastRow() - 1, 2).getValues();
    for (var i = 0; i < setVals.length; i++) {
      settings[setVals[i][0]] = setVals[i][1];
    }
  }

  // Exchange rates from settings with fallback
  var exchangeRates = {
    USD: parseFloat(settings['EXCHANGE_RATE_USD']) || DEFAULT_EXCHANGE_RATES.USD,
    INR: parseFloat(settings['EXCHANGE_RATE_INR']) || DEFAULT_EXCHANGE_RATES.INR,
    EUR: parseFloat(settings['EXCHANGE_RATE_EUR']) || DEFAULT_EXCHANGE_RATES.EUR,
    GBP: parseFloat(settings['EXCHANGE_RATE_GBP']) || DEFAULT_EXCHANGE_RATES.GBP,
    CNY: parseFloat(settings['EXCHANGE_RATE_CNY']) || DEFAULT_EXCHANGE_RATES.CNY,
    NPR: 1.00
  };

  // Determine user role
  var userRole = 'Super Admin'; // Default for developer/owner
  var usersSheet = ss.getSheetByName('Users');
  if (usersSheet && usersSheet.getLastRow() > 1) {
    var uData = usersSheet.getRange(2, 1, usersSheet.getLastRow() - 1, 4).getValues();
    for (var u = 0; u < uData.length; u++) {
      if (String(uData[u][1]).toLowerCase() === userEmail.toLowerCase()) {
        userRole = uData[u][3] || userRole;
        break;
      }
    }
  }

  return {
    success: true,
    userEmail: userEmail,
    role: userRole,
    appName: 'Khadka System',
    companyName: settings['COMPANY_NAME'] || 'Birat Healthcare Industries Pvt. Ltd.',
    exchangeRates: exchangeRates,
    settings: settings,
    timestamp: new Date().toISOString()
  };
}

/**
 * Convert any currency to NPR
 */
function convertToNPR(amount, currency, rates) {
  var amt = parseFloat(amount) || 0;
  var curr = (currency || 'NPR').toUpperCase().trim();
  var rate = (rates && rates[curr]) ? rates[curr] : (DEFAULT_EXCHANGE_RATES[curr] || 1.00);
  return amt * rate;
}

/**
 * High-Performance Dashboard Aggregator
 * Generates all KPI cards, side-by-side comparisons, filtered charts & alert lists
 */
function getDashboard(filterOpts) {
  var ss = getDatabase();
  var bootstrap = getBootstrap();
  var rates = bootstrap.exchangeRates;
  var filters = filterOpts || { period: 'yearly', dateFrom: '', dateTo: '' };

  // 1. Purchase Orders KPI & Totals
  var poSheet = ss.getSheetByName('PurchaseOrders');
  var totalPOValueNPR = 0;
  var pendingPOCount = 0;
  var pendingPOValueNPR = 0;
  var recentPOs = [];

  if (poSheet && poSheet.getLastRow() > 1) {
    var poRows = getSheetObjects(poSheet);
    poRows.forEach(function (po) {
      var valNPR = parseFloat(po.TotalValueNPR) || convertToNPR(po.TotalValue, po.Currency, rates);
      totalPOValueNPR += valNPR;

      var status = (po.Status || '').toLowerCase();
      var recvStatus = (po.ReceivedStatus || '').toLowerCase();
      if (status !== 'completed' && status !== 'cancelled' && recvStatus !== 'fully received') {
        pendingPOCount++;
        pendingPOValueNPR += valNPR;
      }

      recentPOs.push({
        poNo: po.PONo,
        supplierName: po.SupplierName,
        date: po.OrderDate,
        amount: po.TotalValue,
        currency: po.Currency,
        amountNPR: valNPR,
        status: po.Status,
        receivedStatus: po.ReceivedStatus
      });
    });
  }

  // 2. Outstanding Payments (Supplier side vs Customer/Tender side)
  var lcttSheet = ss.getSheetByName('LCTTPayments');
  var supplierOutstandingNPR = 0;
  var supplierPaidNPR = 0;

  if (lcttSheet && lcttSheet.getLastRow() > 1) {
    var lcttRows = getSheetObjects(lcttSheet);
    lcttRows.forEach(function (pay) {
      var amtNPR = parseFloat(pay.AmountNPR) || convertToNPR(pay.Amount, pay.Currency, rates);
      var status = (pay.Status || '').toLowerCase();
      if (status === 'pending' || status === 'in progress') {
        supplierOutstandingNPR += amtNPR;
      } else {
        supplierPaidNPR += amtNPR;
      }
    });
  }

  // Customer outstanding (From Tender / Dispatch balances)
  var tenderSheet = ss.getSheetByName('TenderTracking');
  var customerOutstandingNPR = 0;
  if (tenderSheet && tenderSheet.getLastRow() > 1) {
    var tRows = getSheetObjects(tenderSheet);
    tRows.forEach(function (t) {
      var amt = parseFloat(t.Amount) || 0;
      var dStatus = (t.DispatchStatus || '').toLowerCase();
      // If delivered but pending final settlement
      if (dStatus === 'dispatched' || dStatus === 'partial') {
        customerOutstandingNPR += amt;
      }
    });
  }

  // 3. Import Shipments in Transit (Side-by-side: India vs Third Country)
  var shipSheet = ss.getSheetByName('Shipments');
  var shipmentsTransitIndia = 0;
  var shipmentsTransitThirdCountry = 0;
  var totalShipmentsInTransit = 0;

  if (shipSheet && shipSheet.getLastRow() > 1) {
    var shipRows = getSheetObjects(shipSheet);
    shipRows.forEach(function (s) {
      var status = (s.ShipmentStatus || '').toLowerCase();
      if (status.indexOf('transit') !== -1 || status.indexOf('port') !== -1 || status === 'customs pending' || status === 'in progress') {
        totalShipmentsInTransit++;
        var origin = (s.OriginType || '').toLowerCase();
        var country = (s.OriginCountry || '').toLowerCase();
        if (origin === 'india' || country.indexOf('india') !== -1) {
          shipmentsTransitIndia++;
        } else {
          shipmentsTransitThirdCountry++;
        }
      }
    });
  }

  // 4. Inventory Value & Low Stock Alerts
  var itemSheet = ss.getSheetByName('Items');
  var totalInventoryValueNPR = 0;
  var lowStockItems = [];
  var productionByCategory = {};

  if (itemSheet && itemSheet.getLastRow() > 1) {
    var itemRows = getSheetObjects(itemSheet);
    itemRows.forEach(function (item) {
      var stock = parseFloat(item.CurrentStock) || 0;
      var reorder = parseFloat(item.ReorderLevel) || 0;
      var rate = parseFloat(item.StandardCostNPR) || 0;
      var val = stock * rate;
      totalInventoryValueNPR += val;

      if (stock <= reorder) {
        lowStockItems.push({
          itemCode: item.ItemCode,
          itemName: item.ItemName,
          category: item.Category,
          currentStock: stock,
          reorderLevel: reorder,
          unit: item.Unit,
          warehouse: item.Warehouse,
          shortage: Math.max(0, reorder - stock)
        });
      }

      var cat = item.Category || 'Other';
      if (!productionByCategory[cat]) productionByCategory[cat] = 0;
      productionByCategory[cat] += stock;
    });
  }

  // 5. Production Quantity (Pcs/Units)
  var prodSheet = ss.getSheetByName('Production');
  var totalProductionQty = 0;
  var recentProductions = [];

  if (prodSheet && prodSheet.getLastRow() > 1) {
    var prodRows = getSheetObjects(prodSheet);
    prodRows.forEach(function (pr) {
      var qty = parseFloat(pr.ProducedQty) || 0;
      totalProductionQty += qty;
      recentProductions.push({
        prodOrderId: pr.ProdOrderId,
        date: pr.ProdDate,
        itemName: pr.OutputItemName,
        qty: qty,
        efficiency: pr.EfficiencyPct,
        batchNo: pr.BatchNo
      });
    });
  }

  // 6. Dispatch Quantity (Pcs/Units)
  var dispatchSheet = ss.getSheetByName('Dispatch');
  var totalDispatchQty = 0;
  var recentDispatches = [];

  if (dispatchSheet && dispatchSheet.getLastRow() > 1) {
    var dispRows = getSheetObjects(dispatchSheet);
    dispRows.forEach(function (dp) {
      var qty = parseFloat(dp.TotalQty) || 0;
      totalDispatchQty += qty;
      recentDispatches.push({
        dispatchNo: dp.DispatchNo,
        date: dp.DispatchDate,
        customerName: dp.CustomerName,
        qty: qty,
        challanNo: dp.DeliveryChallanNo,
        status: dp.Status
      });
    });
  }

  // 7. Recent Transactions (Audit Log)
  var auditSheet = ss.getSheetByName('AuditLog');
  var recentTransactions = [];
  if (auditSheet && auditSheet.getLastRow() > 1) {
    var aRows = getSheetObjects(auditSheet);
    // Sort descending by timestamp
    aRows.sort(function (a, b) {
      return new Date(b.Timestamp).getTime() - new Date(a.Timestamp).getTime();
    });
    recentTransactions = aRows.slice(0, 15);
  }

  // 8. Tenders summary
  var tendersList = [];
  if (tenderSheet && tenderSheet.getLastRow() > 1) {
    var tSummary = getSheetObjects(tenderSheet);
    tendersList = tSummary.slice(-10);
  }

  return {
    success: true,
    kpis: {
      totalPOValueNPR: totalPOValueNPR,
      pendingPOCount: pendingPOCount,
      pendingPOValueNPR: pendingPOValueNPR,
      outstandingPayments: {
        supplierOutstandingNPR: supplierOutstandingNPR,
        supplierPaidNPR: supplierPaidNPR,
        customerOutstandingNPR: customerOutstandingNPR,
        period: filters.period || 'yearly'
      },
      shipmentsInTransit: {
        total: totalShipmentsInTransit,
        india: shipmentsTransitIndia,
        thirdCountry: shipmentsTransitThirdCountry
      },
      totalInventoryValueNPR: totalInventoryValueNPR,
      lowStockCount: lowStockItems.length,
      totalProductionQty: totalProductionQty,
      totalDispatchQty: totalDispatchQty
    },
    lists: {
      lowStockItems: lowStockItems,
      recentPOs: recentPOs.slice(-10).reverse(),
      recentProductions: recentProductions.slice(-10).reverse(),
      recentDispatches: recentDispatches.slice(-10).reverse(),
      recentTransactions: recentTransactions,
      tendersList: tendersList
    },
    charts: {
      productionByCategory: productionByCategory,
      procurementTrend: generateProcurementTrend(ss, rates),
      dispatchTrend: generateDispatchTrend(ss)
    },
    exchangeRates: rates,
    timestamp: new Date().toISOString()
  };
}

/**
 * Trend analysis helper: Procurement by month
 */
function generateProcurementTrend(ss, rates) {
  var poSheet = ss.getSheetByName('PurchaseOrders');
  var monthlyMap = {};
  var months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  var currentYear = new Date().getFullYear();

  months.forEach(function (m) {
    monthlyMap[m + ' ' + currentYear] = 0;
  });

  if (poSheet && poSheet.getLastRow() > 1) {
    var rows = getSheetObjects(poSheet);
    rows.forEach(function (r) {
      if (r.OrderDate) {
        var d = new Date(r.OrderDate);
        if (!isNaN(d.getTime())) {
          var key = months[d.getMonth()] + ' ' + d.getFullYear();
          var val = parseFloat(r.TotalValueNPR) || convertToNPR(r.TotalValue, r.Currency, rates);
          if (monthlyMap[key] !== undefined) {
            monthlyMap[key] += val;
          } else {
            monthlyMap[key] = val;
          }
        }
      }
    });
  }

  var labels = Object.keys(monthlyMap);
  var data = labels.map(function (k) { return Math.round(monthlyMap[k]); });
  return { labels: labels, data: data };
}

