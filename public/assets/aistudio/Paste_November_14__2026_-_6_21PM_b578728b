/**
 * Approval Workflow Engine (MD Approval for Quotation/PI, PO Approvals, Indents)
 */
function setApproval(module, id, status, remarks, userEmail) {
  var ss = getDatabase();
  var email = userEmail || Session.getActiveUser().getEmail();

  if (module === 'Quotations') {
    var quotes = getRecords('Quotations', { QuotationNo: id });
    if (quotes.length === 0) throw new Error('Quotation ' + id + ' not found');
    var quote = quotes[0];
    quote.MDApproval = status; // 'Approved' or 'Rejected'
    quote.MDApprovalDate = new Date().toISOString();
    quote.MDNotes = remarks || '';
    quote.Status = status === 'Approved' ? 'Ready for PO' : 'Rejected';
    saveRecord('Quotations', quote, email);
    logAudit('APPROVAL_ACTION', 'Quotations', id, { status: status, remarks: remarks }, email);
    return { success: true, message: 'Quotation ' + id + ' MD approval set to ' + status };
  }

  if (module === 'PurchaseOrders') {
    var pos = getRecords('PurchaseOrders', { PONo: id });
    if (pos.length === 0) throw new Error('Purchase Order ' + id + ' not found');
    var po = pos[0];
    po.ApprovalStatus = status; // 'Approved' or 'Rejected'
    po.Status = status === 'Approved' ? 'Open' : 'Rejected';
    saveRecord('PurchaseOrders', po, email);
    logAudit('APPROVAL_ACTION', 'PurchaseOrders', id, { status: status, remarks: remarks }, email);
    return { success: true, message: 'Purchase Order ' + id + ' approval set to ' + status };
  }

  if (module === 'Indents') {
    var indents = getRecords('Indents', { IndentNo: id });
    if (indents.length === 0) throw new Error('Indent ' + id + ' not found');
    var ind = indents[0];
    ind.Status = status;
    ind.ApprovedBy = email;
    ind.ApprovalDate = new Date().toISOString();
    ind.Remarks = remarks || ind.Remarks;
    saveRecord('Indents', ind, email);
    logAudit('APPROVAL_ACTION', 'Indents', id, { status: status, remarks: remarks }, email);
    return { success: true, message: 'Indent ' + id + ' status set to ' + status };
  }

  throw new Error('Unsupported approval module: ' + module);
}

/**
 * GOODS RECEIPT NOTE (GRN)
 * Generates GRN from approved PO, updates inventory, prevents over-receipt
 */
function receivePurchaseOrder(grnData) {
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);

  try {
    var poNo = grnData.poNo;
    var pos = getRecords('PurchaseOrders', { PONo: poNo });
    if (pos.length === 0) throw new Error('PO ' + poNo + ' not found');
    var po = pos[0];

    if (po.ApprovalStatus !== 'Approved') {
      throw new Error('Cannot receive against unapproved PO ' + poNo);
    }

    var items = [];
    if (typeof grnData.items === 'string') {
      items = JSON.parse(grnData.items);
    } else {
      items = grnData.items || [];
    }

    if (!items || items.length === 0) {
      throw new Error('No items specified for GRN receipt');
    }

    var ss = getDatabase();
    var invSheet = ss.getSheetByName('Inventory');
    var itemSheet = ss.getSheetByName('Items');
    var wh = grnData.warehouse || 'WH-01';
    var userEmail = grnData.userEmail || Session.getActiveUser().getEmail();
    var grnNumber = 'GRN-' + Utilities.getUuid().substring(0, 6).toUpperCase();

    var totalQtyReceivedInThisGRN = 0;

    items.forEach(function (itm) {
      var itemCode = itm.itemCode;
      var qty = parseFloat(itm.receivedQty) || 0;
      if (qty <= 0) return;

      totalQtyReceivedInThisGRN += qty;

      // 1. Find or verify item in item master
      var currentStock = 0;
      var currentValNPR = 0;
      var itemRowIndex = -1;
      var itemName = itm.itemName || '';
      var category = itm.category || 'Raw Materials';
      var stdCost = parseFloat(itm.unitCost) || 0;

      if (itemSheet && itemSheet.getLastRow() > 1) {
        var allItems = itemSheet.getRange(2, 1, itemSheet.getLastRow() - 1, 10).getValues();
        for (var i = 0; i < allItems.length; i++) {
          if (String(allItems[i][0]).toUpperCase() === itemCode.toUpperCase()) {
            itemRowIndex = i + 2;
            itemName = allItems[i][1];
            category = allItems[i][2];
            currentStock = parseFloat(allItems[i][8]) || 0;
            currentValNPR = parseFloat(allItems[i][9]) || 0;
            stdCost = parseFloat(allItems[i][7]) || stdCost;
            break;
          }
        }
      }

      var newStock = currentStock + qty;
      var txValNPR = qty * stdCost;
      var newTotalValNPR = currentValNPR + txValNPR;

      // 2. Append Inventory Ledger entry
      var txId = 'TX-' + Utilities.getUuid().substring(0, 8).toUpperCase();
      invSheet.appendRow([
        txId,
        new Date().toISOString(),
        itemCode,
        itemName,
        category,
        'GRN_RECEIPT',
        poNo + ' / ' + grnNumber + ' (Inv: ' + (grnData.invoiceNo || '') + ')',
        wh,
        qty,
        0,
        newStock,
        stdCost,
        txValNPR,
        itm.batchNo || grnData.batchNo || 'BATCH-' + Utilities.formatDate(new Date(), 'GMT', 'yyyyMMdd'),
        itm.storageLocation || grnData.storageLocation || 'Bay A',
        grnData.mfgDate || '',
        grnData.expDate || '',
        userEmail,
        new Date().toISOString()
      ]);

      // 3. Update stock in Item Master
      if (itemRowIndex > 0) {
        itemSheet.getRange(itemRowIndex, 9).setValue(newStock);
        itemSheet.getRange(itemRowIndex, 10).setValue(newTotalValNPR);
      }
    });

    // 4. Update PO received status
    var currentReceived = parseFloat(po.ReceivedQty) || 0;
    var updatedReceived = currentReceived + totalQtyReceivedInThisGRN;
    po.ReceivedQty = updatedReceived;
    po.PendingQty = Math.max(0, (parseFloat(po.TotalValue) || 0) - updatedReceived);
    po.ReceivedStatus = po.PendingQty === 0 ? 'Fully Received' : 'Partially Received';
    if (po.ReceivedStatus === 'Fully Received') {
      po.Status = 'Completed';
    }
    saveRecord('PurchaseOrders', po, userEmail);

    logAudit('GOODS_RECEIPT', 'PurchaseOrders', poNo, {
      grnNumber: grnNumber,
      invoiceNo: grnData.invoiceNo,
      qtyReceived: totalQtyReceivedInThisGRN
    }, userEmail);

    return {
      success: true,
      grnNumber: grnNumber,
      message: 'GRN ' + grnNumber + ' posted successfully. Inventory updated with ' + totalQtyReceivedInThisGRN + ' units.'
    };
  } catch (err) {
    throw new Error('receivePurchaseOrder failed: ' + err.message);
  } finally {
    lock.releaseLock();
  }
}

/**
 * PRODUCTION PROCESS & MANAGEMENT
 * Consumes raw materials based on BOM, increments finished goods, enforces NO negative stock
 */

/**
 * DISPATCH MANAGEMENT
 * Generates Delivery Challan, validates stock, automatically deducts finished goods
 */
function postDispatch(dispatchData) {
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);

  try {
    var items = [];
    if (typeof dispatchData.items === 'string') {
      items = JSON.parse(dispatchData.items);
    } else {
      items = dispatchData.items || [];
    }

    if (!items || items.length === 0) {
      throw new Error('No items specified in dispatch order');
    }

    var ss = getDatabase();
    var itemSheet = ss.getSheetByName('Items');
    var invSheet = ss.getSheetByName('Inventory');
    var warehouse = dispatchData.warehouse || 'WH-02';
    var userEmail = dispatchData.userEmail || Session.getActiveUser().getEmail();

    // Map items to check stock
    var allItemsMap = {};
    if (itemSheet && itemSheet.getLastRow() > 1) {
      var allData = itemSheet.getRange(2, 1, itemSheet.getLastRow() - 1, 10).getValues();
      for (var i = 0; i < allData.length; i++) {
        var code = String(allData[i][0]).toUpperCase();
        allItemsMap[code] = {
          rowIndex: i + 2,
          code: allData[i][0],
          name: allData[i][1],
          category: allData[i][2],
          unit: allData[i][3],
          cost: parseFloat(allData[i][7]) || 0,
          stock: parseFloat(allData[i][8]) || 0,
          value: parseFloat(allData[i][9]) || 0
        };
      }
    }

    // Validate shortages
    var shortages = [];
    var itemsToDispatch = [];
    var totalDispatchQty = 0;

    items.forEach(function (itm) {
      var code = String(itm.itemCode).toUpperCase();
      var qty = parseFloat(itm.qty) || 0;
      if (qty <= 0) return;

      var master = allItemsMap[code];
      if (!master) {
        shortages.push('Item ' + itm.itemCode + ' not found in item master');
        return;
      }

      if (master.stock < qty) {
        shortages.push('Cannot dispatch ' + qty + ' ' + master.unit + ' of ' + master.name + '. Available stock: ' + master.stock + ' ' + master.unit);
      }

      totalDispatchQty += qty;
      itemsToDispatch.push({
        code: code,
        name: master.name,
        category: master.category,
        qty: qty,
        unit: master.unit,
        unitCost: master.cost,
        masterMeta: master
      });
    });

    if (shortages.length > 0) {
      throw new Error('NEGATIVE STOCK DISPATCH ERROR:\n' + shortages.join('\n'));
    }

    var dispatchNo = 'DSP-' + Utilities.getUuid().substring(0, 6).toUpperCase();
    var challanNo = dispatchData.deliveryChallanNo || 'DC-' + Utilities.formatDate(new Date(), 'GMT', 'yyyyMMdd-HHmm');

    // Deduct stock and log in inventory
    itemsToDispatch.forEach(function (dItm) {
      var meta = dItm.masterMeta;
      var newStock = meta.stock - dItm.qty;
      var newVal = newStock * dItm.unitCost;

      invSheet.appendRow([
        'TX-' + Utilities.getUuid().substring(0, 8).toUpperCase(),
        new Date().toISOString(),
        dItm.code,
        dItm.name,
        dItm.category,
        'DISPATCH_OUT',
        dispatchNo + ' / ' + challanNo + ' (' + (dispatchData.customerName || 'Customer') + ')',
        warehouse,
        0,
        dItm.qty,
        newStock,
        dItm.unitCost,
        dItm.qty * dItm.unitCost,
        dispatchData.batchNo || 'N/A',
        warehouse,
        '',
        '',
        userEmail,
        new Date().toISOString()
      ]);

      itemSheet.getRange(meta.rowIndex, 9).setValue(newStock);
      itemSheet.getRange(meta.rowIndex, 10).setValue(newVal);
    });

    var dispatchRecord = {
      DispatchNo: dispatchNo,
      DispatchDate: dispatchData.dispatchDate || Utilities.formatDate(new Date(), 'GMT', 'yyyy-MM-dd'),
      CustomerName: dispatchData.customerName,
      DestinationAddress: dispatchData.destinationAddress || '',
      Warehouse: warehouse,
      VehicleNo: dispatchData.vehicleNo || '',
      DriverName: dispatchData.driverName || '',
      DriverContact: dispatchData.driverContact || '',
      DeliveryChallanNo: challanNo,
      ItemsJSON: JSON.stringify(itemsToDispatch),
      TotalQty: totalDispatchQty,
      Status: 'Dispatched',
      Remarks: dispatchData.remarks || '',
      LoggedBy: userEmail,
      Timestamp: new Date().toISOString()
    };

    saveRecord('Dispatch', dispatchRecord, userEmail);

    logAudit('POST_DISPATCH', 'Dispatch', dispatchNo, {
      challanNo: challanNo,
      customer: dispatchData.customerName,
      totalQty: totalDispatchQty
    }, userEmail);

    return {
      success: true,
      dispatchNo: dispatchNo,
      challanNo: challanNo,
      totalQty: totalDispatchQty,
      message: 'Dispatch ' + dispatchNo + ' posted successfully. Challan: ' + challanNo + '.'
    };
  } catch (err) {
    throw new Error('postDispatch failed: ' + err.message);
  } finally {
    lock.releaseLock();
  }
}

