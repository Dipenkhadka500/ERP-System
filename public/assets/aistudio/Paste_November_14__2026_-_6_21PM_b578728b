    }

    if (!routine) throw new Error('BOM Routine not found: ' + routineId);

    var isWIP = (routine.processCategory === 'WIP');
    var issues = [];
    var receipts = [];

    if (isWIP) {
      // WIP Issues
      var wipIssueSheet = ss.getSheetByName('BOM_WIP_Issues');
      var wipIssueRows = wipIssueSheet.getDataRange().getValues();
      for (var j = 1; j < wipIssueRows.length; j++) {
        var ir = wipIssueRows[j];
        if (String(ir[1]) === routineId) {
          issues.push({
            issueId: String(ir[0]),
            routineId: String(ir[1]),
            itemCode: String(ir[2]),
            itemName: String(ir[3]),
            width: Number(ir[4]) || 0,
            gsm: Number(ir[5]) || 0,
            length: Number(ir[6]) || 0,
            ratePerKG: Number(ir[7]) || 0,
            weightPerPiece: Number(ir[8]) || 0,
            expectedAmount: Number(ir[9]) || 0,
            remarks: String(ir[10] || '')
          });
        }
      }

      // WIP Receipts
      var wipReceiptSheet = ss.getSheetByName('BOM_WIP_Receipts');
      var wipReceiptRows = wipReceiptSheet.getDataRange().getValues();
      for (var k = 1; k < wipReceiptRows.length; k++) {
        var rr = wipReceiptRows[k];
        if (String(rr[1]) === routineId) {
          receipts.push({
            receiptId: String(rr[0]),
            routineId: String(rr[1]),
            itemCode: String(rr[2]),
            itemName: String(rr[3]),
            unit: String(rr[4]),
            quantity: Number(rr[5]) || 0,
            amount: Number(rr[6]) || 0
          });
        }
      }
    } else {
      // FG Issues
      var fgIssueSheet = ss.getSheetByName('BOM_FG_Issues');
      var fgIssueRows = fgIssueSheet.getDataRange().getValues();
      for (var m = 1; m < fgIssueRows.length; m++) {
        var fir = fgIssueRows[m];
        if (String(fir[1]) === routineId) {
          issues.push({
            issueId: String(fir[0]),
            routineId: String(fir[1]),
            itemCode: String(fir[2]),
            itemName: String(fir[3]),
            unit: String(fir[4]),
            quantity: Number(fir[5]) || 0,
            amount: Number(fir[6]) || 0,
            isWIPReceiptItem: String(fir[7]) === 'Yes',
            linkedWIPRoutineId: String(fir[8] || ''),
            remarks: String(fir[9] || '')
          });
        }
      }

      // FG Receipts
      var fgReceiptSheet = ss.getSheetByName('BOM_FG_Receipts');
      var fgReceiptRows = fgReceiptSheet.getDataRange().getValues();
      for (var n = 1; n < fgReceiptRows.length; n++) {
        var frr = fgReceiptRows[n];
        if (String(frr[1]) === routineId) {
          receipts.push({
            receiptId: String(frr[0]),
            routineId: String(frr[1]),
            itemCode: String(frr[2]),
            itemName: String(frr[3]),
            unit: String(frr[4]),
            quantity: Number(frr[5]) || 0,
            amount: Number(frr[6]) || 0
          });
        }
      }
    }

    return {
      routine: routine,
      issues: issues,
      receipts: receipts
    };
  } catch (err) {
    throw new Error('Failed to load BOM: ' + err.message);
  }
}

function saveWIPBOM(payload) {
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);

  try {
    var ss = getTargetSpreadsheet();
    var routineSheet = ss.getSheetByName('BOM_Routines');
    var issueSheet = ss.getSheetByName('BOM_WIP_Issues');
    var receiptSheet = ss.getSheetByName('BOM_WIP_Receipts');

    var bomName = (payload.bomName || '').trim();
    if (!bomName) throw new Error('BOM Name is required');

    // Naming rule: RT-{BOM Name}
    var cleanBomName = bomName.replace(/^RT-/, '').trim();
    var autoRoutineName = 'RT-' + cleanBomName;

    var routineId = (payload.routineId || '').trim();
    var isNew = (!routineId || routineId === 'NEW' || routineId === 'null' || routineId.indexOf('DRAFT') !== -1);
    if (isNew) {
      routineId = 'RT-WIP-' + Utilities.formatDate(new Date(), 'GMT+5:45', 'yyyyMMdd-HHmmss');
    }

    var baseQty = Number(payload.baseQuantity) || 1000;
    var baseUnit = payload.unit || 'PCS';
    var nowIso = new Date().toISOString();

    // 1. Process Issues and calculate totals
    var totalIssueAmount = 0;
    var processedIssues = [];

    (payload.issues || []).forEach(function(row, idx) {
      var width = Number(row.width) || 0;
      var gsm = Number(row.gsm) || 0;
      var length = Number(row.length) || 0;
      var rate = Number(row.ratePerKG) || 0;

      // Weight per piece calculation: (width * gsm * length) / 1000000
      var weightPerPiece = 0;
      if (width > 0 && gsm > 0 && length > 0) {
        weightPerPiece = (width * gsm * length) / 1000000;
      } else {
        weightPerPiece = Number(row.weightPerPiece) || 0;
      }
      weightPerPiece = parseFloat(weightPerPiece.toFixed(5));

      // Expected Amount: (weightPerPiece in grams * baseQty / 1000) * ratePerKG
      var expectedAmount = 0;
      if (weightPerPiece > 0 && rate > 0) {
        expectedAmount = (weightPerPiece * baseQty / 1000) * rate;
      } else {
        expectedAmount = Number(row.expectedAmount) || 0;
      }
      expectedAmount = parseFloat(expectedAmount.toFixed(2));
      totalIssueAmount += expectedAmount;

      processedIssues.push([
        row.issueId || ('WIP-ISS-' + (idx + 1) + '-' + Utilities.formatDate(new Date(), 'GMT', 'mmss')),
        routineId,
        row.itemCode || '',
        row.itemName || '',
        width,
        gsm,
        length,
        rate,
        weightPerPiece,
        expectedAmount,
        row.remarks || ''
      ]);
    });

    // 2. Process Receipts
    var processedReceipts = [];
    var receiptsInput = payload.receipts || [];
    if (receiptsInput.length === 0) {
      // Default to 1 WIP item receipt based on parent product
      processedReceipts.push([
        'WIP-REC-01-' + Utilities.formatDate(new Date(), 'GMT', 'mmss'),
        routineId,
        payload.parentItemCode || 'WIP-PAD-CORE',
        payload.productName || (cleanBomName + ' Core Pad'),
        baseUnit,
        baseQty,
        parseFloat(totalIssueAmount.toFixed(2))
      ]);
    } else {
      receiptsInput.forEach(function(r, idx) {
        var rAmount = Number(r.amount);
        if (isNaN(rAmount) || rAmount <= 0) {
          rAmount = totalIssueAmount;
        }
        processedReceipts.push([
          r.receiptId || ('WIP-REC-' + (idx + 1) + '-' + Utilities.formatDate(new Date(), 'GMT', 'mmss')),
          routineId,
          r.itemCode || payload.parentItemCode || '',
          r.itemName || payload.productName || '',
          r.unit || baseUnit,
          Number(r.quantity) || baseQty,
          parseFloat(rAmount.toFixed(2))
        ]);
      });
    }

    // 3. Save Routine Header
    var rData = routineSheet.getDataRange().getValues();
    var existingRowIndex = -1;
    for (var i = 1; i < rData.length; i++) {
      if (String(rData[i][0]) === routineId) {
        existingRowIndex = i + 1;
        break;
      }
    }

    var routineRowValues = [
      routineId,
      autoRoutineName,
      cleanBomName,
      'WIP',
      payload.parentItemCode || '',
      payload.productName || cleanBomName,
      baseQty,
      baseUnit,
      '',
      payload.effectiveDate || Utilities.formatDate(new Date(), 'GMT+5:45', 'yyyy-MM-dd'),
      payload.status || 'Active',
      payload.revision || 'Rev 1.0',
      payload.description || '',
      isNew ? nowIso : rData[existingRowIndex - 1][13],
      nowIso
    ];

    if (existingRowIndex > 0) {
      routineSheet.getRange(existingRowIndex, 1, 1, routineRowValues.length).setValues([routineRowValues]);
    } else {
      routineSheet.appendRow(routineRowValues);
    }

    // 4. Replace Issues for this RoutineID
    deleteRowsByMatchingColumn(issueSheet, 2, routineId);
    if (processedIssues.length > 0) {
      issueSheet.getRange(issueSheet.getLastRow() + 1, 1, processedIssues.length, processedIssues[0].length).setValues(processedIssues);
    }

    // 5. Replace Receipts for this RoutineID
    deleteRowsByMatchingColumn(receiptSheet, 2, routineId);
    if (processedReceipts.length > 0) {
      receiptSheet.getRange(receiptSheet.getLastRow() + 1, 1, processedReceipts.length, processedReceipts[0].length).setValues(processedReceipts);
    }

    return {
      success: true,
      message: 'WIP Process BOM saved successfully as ' + autoRoutineName,
      routineId: routineId,
      routineName: autoRoutineName,
      totalIssueAmount: totalIssueAmount
    };
  } catch (err) {
    throw new Error('Error saving WIP BOM: ' + err.message);
  } finally {
    lock.releaseLock();
  }
}

