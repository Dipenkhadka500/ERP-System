function getItemMaster() {
  try {
    var ss = getTargetSpreadsheet();
    var sheet = ss.getSheetByName('Item_Master');
    if (!sheet) {
      initializeDatabase();
      sheet = ss.getSheetByName('Item_Master');
    }
    var data = sheet.getDataRange().getValues();
    if (data.length <= 1) {
      // Fallback to Inventory_Valuation if Item_Master is empty
      return getInventoryValuation();
    }

    var items = [];
    for (var i = 1; i < data.length; i++) {
      var row = data[i];
      if (!row[0]) continue;
      items.push({
        itemCode: String(row[0]).trim(),
        itemName: String(row[1]).trim(),
        category: String(row[2]).trim(),
        unit: String(row[3]).trim(),
        widthMM: Number(row[4]) || 0,
        gsm: Number(row[5]) || 0,
        lengthMM: Number(row[6]) || 0,
        ratePerKG: Number(row[7]) || 0,
        ratePerUnit: Number(row[8]) || 0,
        currentStock: Number(row[9]) || 0,
        status: String(row[10] || 'Active').trim(),
        description: String(row[11] || '').trim()
      });
    }
    return items;
  } catch (err) {
    return getInventoryValuation();
  }
}

