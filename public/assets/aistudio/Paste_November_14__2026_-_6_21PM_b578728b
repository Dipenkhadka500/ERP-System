/**
 * Helper: Read all sheet rows into an array of JavaScript Objects using Header row as keys
 */
function getSheetObjects(sheet) {
  if (!sheet || sheet.getLastRow() <= 1) return [];
  var lastRow = sheet.getLastRow();
  var lastCol = sheet.getLastColumn();
  var data = sheet.getRange(1, 1, lastRow, lastCol).getValues();
  var headers = data[0];
  var results = [];

  for (var r = 1; r < data.length; r++) {
    var obj = { _row: r + 1 };
    var hasContent = false;
    for (var c = 0; c < headers.length; c++) {
      var header = headers[c];
      var cellVal = data[r][c];
      if (cellVal instanceof Date) {
        cellVal = Utilities.formatDate(cellVal, Session.getScriptTimeZone(), 'yyyy-MM-dd HH:mm:ss');
      }
      obj[header] = cellVal;
      if (cellVal !== '' && cellVal !== null && cellVal !== undefined) {
        hasContent = true;
      }
    }
    if (hasContent) {
      results.push(obj);
    }
  }
  return results;
}

/**
 * Universal Save Record (Create / Update)
 * Enforces LockService, Timestamping, ID generation and Audit Logging
 */
function saveRecord(sheetName, recordData, userEmail) {
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);

  try {
    var ss = getDatabase();
    var sheet = ss.getSheetByName(sheetName);
    if (!sheet) throw new Error('Sheet not found: ' + sheetName);

    var headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
    var primaryKey = headers[0];
    var idValue = recordData[primaryKey];
    var isNew = !idValue;

    if (isNew) {
      idValue = generateUniqueId(sheetName);
      recordData[primaryKey] = idValue;
    }

    // Auto calculate NPR fields if currency provided
    var bootstrap = getBootstrap();
    if (recordData.Currency && recordData.TotalValue && !recordData.TotalValueNPR) {
      recordData.TotalValueNPR = convertToNPR(recordData.TotalValue, recordData.Currency, bootstrap.exchangeRates);
    }
    if (recordData.Currency && recordData.TotalAmount && !recordData.TotalAmountNPR) {
      recordData.TotalAmountNPR = convertToNPR(recordData.TotalAmount, recordData.Currency, bootstrap.exchangeRates);
    }
    if (recordData.Currency && recordData.Amount && !recordData.AmountNPR) {
      recordData.AmountNPR = convertToNPR(recordData.Amount, recordData.Currency, bootstrap.exchangeRates);
    }

    recordData['Timestamp'] = new Date().toISOString();

    var existingRow = -1;
    if (!isNew && sheet.getLastRow() > 1) {
      var idList = sheet.getRange(2, 1, sheet.getLastRow() - 1, 1).getValues();
      for (var i = 0; i < idList.length; i++) {
        if (String(idList[i][0]) === String(idValue)) {
          existingRow = i + 2;
          break;
        }
      }
    }

    var rowValues = [];
    for (var h = 0; h < headers.length; h++) {
      var colName = headers[h];
      var val = recordData[colName];
      if (typeof val === 'object' && val !== null) {
        val = JSON.stringify(val);
      }
      rowValues.push(val !== undefined ? val : '');
    }

    if (existingRow > 0) {
      sheet.getRange(existingRow, 1, 1, headers.length).setValues([rowValues]);
      logAudit('UPDATE_RECORD', sheetName, idValue, recordData, userEmail);
    } else {
      sheet.appendRow(rowValues);
      logAudit('CREATE_RECORD', sheetName, idValue, recordData, userEmail);
    }

    // Trigger workflow side-effects
    handlePostSaveWorkflow(sheetName, recordData, userEmail);

    return {
      success: true,
      id: idValue,
      message: 'Record ' + (existingRow > 0 ? 'updated' : 'created') + ' successfully in ' + sheetName,
      data: recordData
    };
  } catch (err) {
    throw new Error('saveRecord error in ' + sheetName + ': ' + err.message);
  } finally {
    lock.releaseLock();
  }
}

/**
 * ID generator prefix rules
 */
function generateUniqueId(sheetName) {
  var prefixMap = {
    'Indents': 'IND',
    'Suppliers': 'SUP',
    'FreightForwarder': 'FF',
    'Quotations': 'QT',
    'PurchaseOrders': 'PO',
    'LCTTPayments': 'PAY',
    'Shipments': 'SHP',
    'Tenders': 'TND',
    'TenderTracking': 'TRK',
    'Items': 'ITM',
    'Inventory': 'TX',
    'Warehouses': 'WH',
    'BOM': 'BOM',
    'Production': 'PRD',
    'Dispatch': 'DSP',
    'Users': 'USR'
  };
  var prefix = prefixMap[sheetName] || 'REC';
  var ss = getDatabase();
  var sheet = ss.getSheetByName(sheetName);
  var nextNum = 1001;
  if (sheet && sheet.getLastRow() > 1) {
    nextNum = 1000 + sheet.getLastRow();
  }
  return prefix + '-' + nextNum;
}

/**
 * Delete Record with Audit Trail
 */
function deleteRecord(sheetName, recordId, userEmail) {
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);

  try {
    var ss = getDatabase();
    var sheet = ss.getSheetByName(sheetName);
    if (!sheet) throw new Error('Sheet not found: ' + sheetName);

    var idList = sheet.getRange(2, 1, Math.max(1, sheet.getLastRow() - 1), 1).getValues();
    var targetRow = -1;
    for (var i = 0; i < idList.length; i++) {
      if (String(idList[i][0]) === String(recordId)) {
        targetRow = i + 2;
        break;
      }
    }

    if (targetRow === -1) {
      throw new Error('Record with ID ' + recordId + ' not found in ' + sheetName);
    }

    sheet.deleteRow(targetRow);
    logAudit('DELETE_RECORD', sheetName, recordId, 'Row ' + targetRow + ' deleted', userEmail);

    return {
      success: true,
      message: 'Record ' + recordId + ' successfully deleted from ' + sheetName
    };
  } catch (err) {
    throw new Error('deleteRecord error: ' + err.message);
  } finally {
    lock.releaseLock();
  }
}

