function cloneBOMRoutine(sourceRoutineId, newBomName) {
  try {
    var sourceData = getBOMDetails(sourceRoutineId);
    if (!sourceData || !sourceData.routine) {
      throw new Error('Source routine not found: ' + sourceRoutineId);
    }

    var cleanName = (newBomName || (sourceData.routine.bomName + ' COPY')).trim().replace(/^RT-/, '');
    var isWIP = (sourceData.routine.processCategory === 'WIP');

    var newPayload = {
      routineId: 'NEW',
      bomName: cleanName,
      routineName: 'RT-' + cleanName,
      processCategory: sourceData.routine.processCategory,
      parentItemCode: sourceData.routine.parentItemCode ? (sourceData.routine.parentItemCode + '-COPY') : '',
      productName: sourceData.routine.productName ? (sourceData.routine.productName + ' (Copy)') : cleanName,
      baseQuantity: sourceData.routine.baseQuantity || (isWIP ? 1000 : 100),
      unit: sourceData.routine.unit || (isWIP ? 'PCS' : 'PKT'),
      linkedWIPRoutineId: sourceData.routine.linkedWIPRoutineId || '',
      effectiveDate: Utilities.formatDate(new Date(), 'GMT+5:45', 'yyyy-MM-dd'),
      status: 'Active',
      revision: 'Rev 1.0',
      description: 'Cloned from ' + sourceData.routine.routineName,
      issues: sourceData.issues || [],
      receipts: sourceData.receipts || []
    };

    return isWIP ? saveWIPBOM(newPayload) : saveFGBOM(newPayload);
  } catch (err) {
    throw new Error('Failed to clone routine: ' + err.message);
  }
}

function saveProductionRun(payload) {
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);

  try {
    var ss = getTargetSpreadsheet();
    var runSheet = ss.getSheetByName('Production_Runs');
    var issueSheet = ss.getSheetByName('Production_Run_Issues');
    var receiptSheet = ss.getSheetByName('Production_Run_Receipts');

    var runId = 'RUN-' + Utilities.formatDate(new Date(), 'GMT+5:45', 'yyyyMMdd-HHmmss');
    var prodDate = payload.productionDate || Utilities.formatDate(new Date(), 'GMT+5:45', 'yyyy-MM-dd');
    var routineId = payload.routineId || '';
    var routineName = payload.routineName || '';
    var plannedQty = Number(payload.plannedQuantity) || 0;
    var unit = payload.unit || 'PCS';

    var totalIssueVariance = 0;
    var processedIssues = [];

    (payload.issues || []).forEach(function(item, idx) {
      var bomQty = Number(item.bomQuantity) || 0;
      var actQty = Number(item.actualQuantity) || 0;
      var variance = actQty - bomQty;
      variance = parseFloat(variance.toFixed(3));
      totalIssueVariance += variance;

      processedIssues.push([
        'RUN-ISS-' + (idx + 1) + '-' + runId,
        runId,
        item.itemCode || '',
        item.itemName || '',
        item.unit || 'KG',
        bomQty,
        actQty,
        variance,
        Number(item.weightPerPiece) || 0,
        Number(item.rate) || 0,
        item.remarks || ''
      ]);
    });

    var totalReceiptVariance = 0;
    var processedReceipts = [];

    (payload.receipts || []).forEach(function(item, idx) {
      var bomQty = Number(item.bomQuantity) || 0;
      var actQty = Number(item.actualQuantity) || 0;
      var variance = actQty - bomQty;
      variance = parseFloat(variance.toFixed(3));
      totalReceiptVariance += variance;

      processedReceipts.push([
        'RUN-REC-' + (idx + 1) + '-' + runId,
        runId,
        item.itemCode || '',
        item.itemName || '',
        item.unit || unit,
        bomQty,
        actQty,
        variance,
        item.remarks || ''
      ]);
    });

    // Append Header
    runSheet.appendRow([
      runId,
      prodDate,
      routineId,
      routineName,
      payload.processCategory || 'WIP',
      plannedQty,
      unit,
      'Completed',
      parseFloat(totalIssueVariance.toFixed(3)),
      parseFloat(totalReceiptVariance.toFixed(3)),
      new Date().toISOString(),
      payload.recordedBy || 'Production Supervisor',
      payload.remarks || ''
    ]);

    if (processedIssues.length > 0) {
      issueSheet.getRange(issueSheet.getLastRow() + 1, 1, processedIssues.length, processedIssues[0].length).setValues(processedIssues);
    }

    if (processedReceipts.length > 0) {
      receiptSheet.getRange(receiptSheet.getLastRow() + 1, 1, processedReceipts.length, processedReceipts[0].length).setValues(processedReceipts);
    }

    return {
      success: true,
      runId: runId,
      message: 'Production Issue and Receipt recorded successfully on ' + prodDate + ' under Run ID: ' + runId
    };
  } catch (err) {
    throw new Error('Failed to save production run: ' + err.message);
  } finally {
    lock.releaseLock();
  }
}

function getProductionRuns() {
  try {
    var ss = getTargetSpreadsheet();
    var sheet = ss.getSheetByName('Production_Runs');
    if (!sheet) return [];

    var data = sheet.getDataRange().getValues();
    if (data.length <= 1) return [];

    var runs = [];
    for (var i = data.length - 1; i >= 1; i--) {
      var row = data[i];
      if (!row[0]) continue;
      runs.push({
        runId: String(row[0]),
        productionDate: row[1] ? formatDateString(row[1]) : '',
        routineId: String(row[2]),
        routineName: String(row[3]),
        processCategory: String(row[4]),
        plannedQuantity: Number(row[5]) || 0,
        unit: String(row[6]),
        status: String(row[7]),
        totalIssueVariance: Number(row[8]) || 0,
        totalReceiptVariance: Number(row[9]) || 0,
        recordedAt: row[10] ? formatDateString(row[10]) : '',
        recordedBy: String(row[11] || ''),
        remarks: String(row[12] || '')
      });
    }
    return runs;
  } catch (err) {
    throw new Error('Error loading production runs: ' + err.message);
  }
}

function getProductionRunDetails(runId) {
  try {
    var ss = getTargetSpreadsheet();
    var runSheet = ss.getSheetByName('Production_Runs');
    var issueSheet = ss.getSheetByName('Production_Run_Issues');
    var receiptSheet = ss.getSheetByName('Production_Run_Receipts');

    var runRows = runSheet.getDataRange().getValues();
    var run = null;
    for (var i = 1; i < runRows.length; i++) {
      if (String(runRows[i][0]) === runId) {
        var r = runRows[i];
        run = {
          runId: String(r[0]),
          productionDate: r[1] ? formatDateString(r[1]) : '',
          routineId: String(r[2]),
          routineName: String(r[3]),
          processCategory: String(r[4]),
          plannedQuantity: Number(r[5]) || 0,
          unit: String(r[6]),
          status: String(r[7]),
          totalIssueVariance: Number(r[8]) || 0,
          totalReceiptVariance: Number(r[9]) || 0,
          recordedAt: r[10] ? formatDateString(r[10]) : '',
          recordedBy: String(r[11] || ''),
          remarks: String(r[12] || '')
        };
        break;
      }
    }

    if (!run) throw new Error('Production run not found: ' + runId);

    var issues = [];
    var issueRows = issueSheet.getDataRange().getValues();
    for (var j = 1; j < issueRows.length; j++) {
      if (String(issueRows[j][1]) === runId) {
        var ir = issueRows[j];
        issues.push({
          itemCode: String(ir[2]),
          itemName: String(ir[3]),
          unit: String(ir[4]),
          bomQuantity: Number(ir[5]) || 0,
          actualQuantity: Number(ir[6]) || 0,
          varianceQuantity: Number(ir[7]) || 0,
          weightPerPiece: Number(ir[8]) || 0,
          rate: Number(ir[9]) || 0,
          remarks: String(ir[10] || '')
        });
      }
    }

    var receipts = [];
    var receiptRows = receiptSheet.getDataRange().getValues();
    for (var k = 1; k < receiptRows.length; k++) {
      if (String(receiptRows[k][1]) === runId) {
        var rr = receiptRows[k];
        receipts.push({
          itemCode: String(rr[2]),
          itemName: String(rr[3]),
          unit: String(rr[4]),
          bomQuantity: Number(rr[5]) || 0,
          actualQuantity: Number(rr[6]) || 0,
          varianceQuantity: Number(rr[7]) || 0,
          remarks: String(rr[8] || '')
        });
      }
    }

    return {
      run: run,
      issues: issues,
      receipts: receipts
    };
  } catch (err) {
    throw new Error('Error getting run details: ' + err.message);
  }
}

function deleteRowsByMatchingColumn(sheet, colIndex, targetValue) {
  var lastRow = sheet.getLastRow();
  if (lastRow <= 1) return;

  var values = sheet.getRange(1, colIndex, lastRow, 1).getValues();
  for (var i = lastRow - 1; i >= 1; i--) {
    if (String(values[i][0]) === String(targetValue)) {
      sheet.deleteRow(i + 1);
    }
  }
}

function formatDateString(val) {
  if (!val) return '';
  if (val instanceof Date) {
    return Utilities.formatDate(val, 'GMT+5:45', 'yyyy-MM-dd');
  }
  var str = String(val);
  if (str.length >= 10 && str.charAt(4) === '-' && str.charAt(7) === '-') {
    return str.substring(0, 10);
  }
  return str;
}
