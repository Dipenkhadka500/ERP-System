 */
function doGet(e) {
  var template = HtmlService.createTemplateFromFile('Index');
  template.appUrl = ScriptApp.getService().getUrl();
  return template.evaluate()
    .setTitle('Khadka System - Manufacturing ERP')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1.0')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

/**
 * Returns active spreadsheet instance with fallback to configured spreadsheet.
 * Does not create a new spreadsheet when the configured spreadsheet is available.
 */
function getDatabase() {
  try {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    if (ss) return ss;
  } catch (err) {
    // Unbound standalone execution
  }

  var sheetId = SCRIPT_PROP.getProperty('ERP_SHEET_ID') || ERP_SPREADSHEET_ID;

  if (sheetId) {
    try {
      return SpreadsheetApp.openById(sheetId);
    } catch (e) {
      throw new Error('Unable to access configured ERP spreadsheet: ' + e.message);
    }
  }

  throw new Error('ERP Spreadsheet ID is not configured.');
}
/**
 * Set target Spreadsheet ID manually
 */
function setTargetSpreadsheetId(sheetId) {
  try {
    var ss = SpreadsheetApp.openById(sheetId);

    SCRIPT_PROP.setProperty('ERP_SHEET_ID', sheetId);

    return {
      success: true,
      message: 'Connected to spreadsheet: ' + ss.getName(),
      spreadsheetUrl: ss.getUrl()
    };

  } catch (err) {
    throw new Error(
      'Failed to open spreadsheet with ID ' + sheetId + ': ' + err.message
    );
  }
}

